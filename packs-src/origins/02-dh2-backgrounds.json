        {
          "key": "armour", "type": "one", "label": "Enforcer light carapace armour or carapace chestplate",
          "options": [
            {"label": "Enforcer Light Carapace Armour", "grants": {"equipment": [{"name": "Enforcer Light Carapace Armour"}]}},
            {"label": "Carapace Chestplate", "grants": {"equipment": [{"name": "Carapace Chestplate"}]}}
