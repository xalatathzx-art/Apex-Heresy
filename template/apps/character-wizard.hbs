{{#if missing}}
<div class="wizard-missing">{{localize "WIZARD.NO_ACTOR"}}</div>
{{else}}
<div class="character-wizard-body">
    {{#if rulesetChosen}}
    <nav class="wizard-steps">
        {{#each steps as |s|}}
        <span class="wizard-step-chip{{#if s.active}} active{{/if}}{{#if s.done}} done{{/if}}">{{s.label}}</span>
        {{/each}}
    </nav>
    {{/if}}

    <div class="wizard-step-body">
        {{#unless rulesetChosen}}
        <div class="form-group">
            <label>{{localize "WIZARD.RULESET"}}</label>
            <div class="form-fields">
                <select class="wizard-ruleset">
                    <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                    {{#each rulesets as |r|}}
                    <option value="{{r.key}}" {{#if r.selected}}selected{{/if}}>{{r.label}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
        {{!-- Книги, правила создания которых ещё не сверены с текстом: вести по ним
              Мастер не станет, и молчать об этом нельзя. --}}
        {{#if unaudited}}
        <p class="wizard-note">{{localize "WIZARD.UNAUDITED"}} {{unaudited}}</p>
        {{/if}}
        {{else}}
        <h1 class="wizard-step-title">{{step.label}}</h1>
        <div class="wizard-step-content" data-step="{{step.id}}" data-kind="{{step.kind}}">
            {{#if (eq step.kind "origin")}}
                {{#if originLocked}}
                {{!-- Шаг уже закреплён. Переспросить можно только через «Назад»,
                      который снимет выданное — иначе выдачи наложились бы. --}}
                <p class="wizard-locked">{{localize "WIZARD.LOCKED"}} <b>{{originName}}</b></p>
                {{else}}
                <div class="form-group">
                    <label>{{step.label}}</label>
                    <div class="form-fields">
                        <select data-origin-step="{{step.id}}">
                            <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                            {{#each originOptions as |o|}}
                            <option value="{{o.uuid}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="wizard-choice-rows">{{{choiceRows}}}</div>
                {{/if}}

                {{!-- Текст книги под выбранным. Ради него всё и затевалось: игрок
                      должен читать, что он берёт, а не угадывать по названию. --}}
                {{#if originBook}}
                <section class="wizard-book">
                    <div class="wizard-book-text">{{{originBook.description}}}</div>
                    {{#each originBook.bonuses as |bonus|}}
                    <div class="wizard-book-bonus">
                        <h2>{{bonus.name}}</h2>
                        {{{bonus.description}}}
                    </div>
                    {{/each}}
                    {{#if originBook.summary.length}}
                    <ul class="wizard-book-grants">
                        {{#each originBook.summary as |line|}}<li>{{line}}</li>{{/each}}
                    </ul>
                    {{/if}}
                    {{#if originBook.source}}
                    <p class="wizard-book-source">{{originBook.source}}</p>
                    {{/if}}
                </section>
                {{/if}}
            {{/if}}

            {{#if (eq step.kind "characteristics")}}
                {{#if charLocked}}
                {{!-- Уже сгенерировано. «Назад» снимает запись, и шаг можно пройти заново. --}}
                <p class="wizard-locked">{{localize "WIZARD.CHAR_LOCKED"}}</p>
                {{#if charBlessing}}<p class="wizard-note">{{charBlessing}}</p>{{/if}}
                {{else}}
                <div class="form-group">
                    <label>{{localize "WIZARD.METHOD_LABEL"}}</label>
                    <div class="form-fields">
                        <select class="wizard-char-method">
                            {{#each charMethods as |m|}}
                            <option value="{{m.key}}" {{#if m.selected}}selected{{/if}}>{{m.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                {{#if charPointBuy}}
                <p class="wizard-note">{{localize "WIZARD.POINT_BUY_HINT"}}
                    <span class="wizard-budget" data-spent>0</span> / {{charBudget}}</p>
                {{/if}}
                {{!-- Строка как на анкете: имя — спуск броска, значение крупное и несёт
                      строку, формула стоит тихой подписью. --}}
                <div class="wizard-chars">
                    {{#each charRows as |row|}}
                    <div class="wizard-char">
                        {{#if ../charPointBuy}}
                        <span class="wizard-char-name">{{row.label}}</span>
                        {{else}}
                        <button type="button" class="wizard-roll" data-roll="{{row.key}}"
                                data-formula="{{row.formula}}" title="{{row.formula}}">{{row.label}}</button>
                        {{/if}}
                        <span class="wizard-char-mod">{{#if row.modifier}}{{#if (gt row.modifier 0)}}+{{/if}}{{row.modifier}}{{/if}}</span>
                        <span class="wizard-char-formula">{{#unless ../charPointBuy}}{{row.formula}}{{/unless}}</span>
                        <input type="number" class="wizard-char-value" data-characteristic="{{row.key}}"
                               value="{{row.value}}" data-start="{{row.start}}"/>
                    </div>
                    {{/each}}
                </div>
                {{#unless charPointBuy}}
                <div class="wizard-char-actions">
                    <button type="button" class="wizard-roll-all">{{localize "WIZARD.ROLL_ALL_BUTTON"}}</button>
                </div>
                {{/unless}}
                {{/if}}
            {{/if}}

            {{#if (eq step.kind "experience")}}
                <p>{{localize "WIZARD.STARTING_XP"}} <b>{{experiencePool}}</b></p>
                <p class="wizard-note">{{localize "WIZARD.APTITUDES"}} {{aptitudeList}}</p>
                {{#if owedAptitudes}}
                {{!-- Книга, стр. 79: повторная склонность не пропадает, а меняется
                      на другую характеристическую. Выбирает игрок. --}}
                <p class="wizard-warn">{{localize "WIZARD.OWED_APTITUDES"}} {{owedAptitudes}}</p>
                {{/if}}
                <p class="wizard-note">{{localize "WIZARD.ACQUISITIONS"}} <b>{{influenceBonus}}</b></p>
                {{#if experienceApplied}}
                <p class="wizard-locked">{{localize "WIZARD.XP_APPLIED"}}</p>
                {{/if}}
            {{/if}}

            {{#if (eq step.kind "divination")}}
                {{#if divinationDrawn}}
                <p class="wizard-divination">{{divinationText}}</p>
                <button type="button" class="wizard-reroll-divination">{{localize "WIZARD.REROLL"}}</button>
                {{else}}
                <p class="wizard-note">{{localize "WIZARD.DIVINATION_HINT"}}</p>
                {{/if}}
            {{/if}}
        </div>
        {{/unless}}
    </div>

    <footer class="wizard-footer">
        <button type="button" data-action="wizard-back" {{#if backDisabled}}disabled{{/if}}>
            {{localize "WIZARD.BACK"}}
        </button>
        <button type="button" data-action="wizard-next" {{#if nextDisabled}}disabled{{/if}}>
            {{#if isLastStep}}{{localize "WIZARD.FINISH"}}{{else}}{{localize "WIZARD.NEXT"}}{{/if}}
        </button>
    </footer>
</div>
{{/if}}
