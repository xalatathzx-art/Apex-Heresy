{{#if missing}}
<div class="wizard-missing">{{localize "WIZARD.NO_ACTOR"}}</div>
{{else}}
<div class="character-wizard-body">
    {{#if rulesetChosen}}
    <nav class="wizard-steps">
        {{#each steps as |s|}}
        <span class="wizard-step-chip{{#if s.active}} active{{/if}}{{#if s.done}} done{{/if}}">{{s.label}}</span>
        {{/each}}
    </nav>
    {{/if}}

    <div class="wizard-step-body">
        {{#unless rulesetChosen}}
        <div class="form-group">
            <label>{{localize "WIZARD.RULESET"}}</label>
            <div class="form-fields">
                <select class="wizard-ruleset">
                    <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                    {{#each rulesets as |r|}}
                    <option value="{{r.key}}" {{#if r.selected}}selected{{/if}}>{{r.label}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
        {{!-- Книги, правила создания которых ещё не сверены с текстом: вести по ним
              Мастер не станет, и молчать об этом нельзя. --}}
        {{#if unaudited}}
        <p class="wizard-note">{{localize "WIZARD.UNAUDITED"}} {{unaudited}}</p>
        {{/if}}
        {{else}}
        <h1 class="wizard-step-title">{{step.label}}</h1>
        <div class="wizard-step-content" data-step="{{step.id}}" data-kind="{{step.kind}}">
            {{#if originStep}}
                {{#if originLocked}}
                {{!-- Шаг уже закреплён. Переспросить можно только через «Назад»,
                      который снимет выданное — иначе выдачи наложились бы. --}}
                <p class="wizard-locked">{{localize "WIZARD.LOCKED"}} <b>{{originName}}</b></p>
                {{else}}
                <div class="form-group">
                    <label>{{step.label}}</label>
                    <div class="form-fields">
                        <select data-origin-step="{{step.id}}">
                            <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                            {{#each originOptions as |o|}}
                            <option value="{{o.uuid}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="wizard-choice-rows">{{{choiceRows}}}</div>
                {{/if}}

                {{!-- Полк собирается один на весь отряд (стр. 58): или берётся готовый,
                      или строится за 12 очков и сохраняется предметом мира. --}}
                {{#if (eq step.kind "regiment")}}
                <div class="regiment-builder">
                    <button type="button" class="shop-buy" data-action="regiment-build">
                        {{#if regimentBuilding}}{{localize "WIZARD.REGIMENT_BUILD_CLOSE"}}{{else}}{{localize "WIZARD.REGIMENT_BUILD"}}{{/if}}</button>
                    {{#if regimentBuilding}}
                    <div class="shop-ledger shop-ledger-two">
                        <div class="shop-ledger-cell">
                            <span class="shop-ledger-label">{{localize "WIZARD.REGIMENT_BUDGET"}}</span>
                            <span class="shop-ledger-value">{{regimentBudget}}</span>
                        </div>
                        <div class="shop-ledger-cell shop-ledger-remaining">
                            <span class="shop-ledger-label">{{localize "WIZARD.SHOP_REMAINING"}}</span>
                            <span class="shop-ledger-value">{{regimentLeft}}</span>
                        </div>
                    </div>
                    <div class="wizard-choice">
                        <span class="wizard-choice-label">{{localize "WIZARD.REGIMENT_NAME"}}</span>
                        <input type="text" class="regiment-name" value="{{regimentName}}"/>
                    </div>
                    <div class="wizard-choice">
                        <span class="wizard-choice-label">{{localize "ORIGIN.STAGE.REGIMENT_ORIGIN"}}</span>
                        <select data-regiment-part="homeWorld">
                            <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                            {{#each regimentHomeWorlds as |part|}}
                            <option value="{{part.key}}" {{#if part.selected}}selected{{/if}}>{{part.name}} ({{part.cost}})</option>
                            {{/each}}
                        </select>
                    </div>
                    {{#if regimentCharacteristicChoice}}
                    <div class="wizard-choice">
                        <span class="wizard-choice-label">{{regimentCharacteristicChoice.label}}</span>
                        <div class="regiment-picks">
                            {{#each regimentCharacteristicChoice.options as |option|}}
                            <label class="regiment-pick"><input type="checkbox" data-regiment-characteristic="{{option.key}}"
                                {{#if option.taken}}checked{{/if}}/> {{option.label}}</label>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}
                    <div class="wizard-choice">
                        <span class="wizard-choice-label">{{localize "ORIGIN.STAGE.REGIMENT_COMMANDER"}}</span>
                        <select data-regiment-part="commander">
                            <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                            {{#each regimentCommanders as |part|}}
                            <option value="{{part.key}}" {{#if part.selected}}selected{{/if}}>{{part.name}} ({{part.cost}})</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="wizard-choice">
                        <span class="wizard-choice-label">{{localize "ORIGIN.STAGE.REGIMENT_TYPE"}}</span>
                        <select data-regiment-part="regimentType">
                            <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                            {{#each regimentTypes as |part|}}
                            <option value="{{part.key}}" {{#if part.selected}}selected{{/if}}>{{part.name}} ({{part.cost}})</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="wizard-choice">
                        <span class="wizard-choice-label">{{localize "ORIGIN.STAGE.DOCTRINE"}}</span>
                        <div class="regiment-picks">
                            {{#each regimentDoctrines as |part|}}
                            <label class="regiment-pick"><input type="checkbox" data-regiment-doctrine="{{part.key}}"
                                {{#if part.taken}}checked{{/if}}/> {{part.name}} ({{part.cost}})</label>
                            {{/each}}
                        </div>
                    </div>
                    {{#each regimentTargets as |target|}}
                    <div class="wizard-choice">
                        <span class="wizard-choice-label">{{target.label}}</span>
                        <input type="text" data-regiment-target="{{target.key}}" value="{{target.value}}"/>
                    </div>
                    {{/each}}

                    <div class="shop-ledger shop-ledger-two">
                        <div class="shop-ledger-cell">
                            <span class="shop-ledger-label">{{localize "WIZARD.REGIMENT_KIT_POINTS"}}</span>
                            <span class="shop-ledger-value">{{regimentKitPoints}}</span>
                        </div>
                        <div class="shop-ledger-cell shop-ledger-remaining">
                            <span class="shop-ledger-label">{{localize "WIZARD.SHOP_SPENT"}}</span>
                            <span class="shop-ledger-value">{{regimentKitSpent}}</span>
                        </div>
                    </div>
                    <div class="shop-list regiment-kit">
                        {{#each regimentKit as |row|}}
                        <div class="shop-row{{#if row.taken}} maxed{{/if}}">
                            <span class="shop-name">{{row.label}}</span>
                            <span class="shop-step">{{#if row.taken}}x{{row.taken}}{{/if}}</span>
                            <span class="shop-match"></span>
                            <span class="shop-cost">{{row.cost}}</span>
                            <button type="button" class="shop-buy" data-regiment-kit="{{row.key}}">{{localize "WIZARD.OWED_TAKE"}}</button>
                        </div>
                        {{/each}}
                    </div>

                    {{#each regimentProblems as |problem|}}
                    <p class="wizard-warn">{{problem}}</p>
                    {{/each}}
                    <button type="button" class="shop-buy" data-action="regiment-save"
                            {{#unless regimentReady}}disabled{{/unless}}>{{localize "WIZARD.REGIMENT_SAVE"}}</button>
                    {{/if}}
                </div>
                {{/if}}

                {{!-- Текст книги под выбранным. Ради него всё и затевалось: игрок
                      должен читать, что он берёт, а не угадывать по названию. --}}
                {{#if originBook}}
                <section class="wizard-book">
                    <div class="wizard-book-text">{{{originBook.description}}}</div>
                    {{#each originBook.bonuses as |bonus|}}
                    <div class="wizard-book-bonus">
                        <h2>{{bonus.name}}</h2>
                        {{{bonus.description}}}
                    </div>
                    {{/each}}
                    {{#if originBook.summary.length}}
                    <ul class="wizard-book-grants">
                        {{#each originBook.summary as |line|}}<li>{{line}}</li>{{/each}}
                    </ul>
                    {{/if}}
                    {{#if originBook.source}}
                    <p class="wizard-book-source">{{originBook.source}}</p>
                    {{/if}}
                </section>
                {{/if}}
            {{/if}}

            {{#if (eq step.kind "characteristics")}}
                {{#if charLocked}}
                {{!-- Уже сгенерировано. «Назад» снимает запись, и шаг можно пройти заново. --}}
                <p class="wizard-locked">{{localize "WIZARD.CHAR_LOCKED"}}</p>
                {{#if charBlessing}}<p class="wizard-note">{{charBlessing}}</p>{{/if}}
                {{else}}
                <div class="form-group">
                    <label>{{localize "WIZARD.METHOD_LABEL"}}</label>
                    <div class="form-fields">
                        <select class="wizard-char-method">
                            {{#each charMethods as |m|}}
                            <option value="{{m.key}}" {{#if m.selected}}selected{{/if}}>{{m.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                {{#if charPointBuy}}
                <p class="wizard-note">{{localize "WIZARD.POINT_BUY_HINT"}}
                    <span class="wizard-budget" data-spent>0</span> / {{charBudget}}</p>
                {{/if}}
                {{!-- Строка как на анкете: имя — спуск броска, значение крупное и несёт
                      строку, формула стоит тихой подписью. --}}
                <div class="wizard-chars">
                    {{#each charRows as |row|}}
                    <div class="wizard-char">
                        {{!-- Кнопка-кость там, где книга велит катать: при закупке очков
                              она остаётся у одной Тёмной славы (Black Crusade, стр. 53). --}}
                        {{#if row.rollable}}
                        <button type="button" class="wizard-roll" data-roll="{{row.key}}"
                                data-formula="{{row.formula}}" title="{{row.formula}}">{{row.label}}</button>
                        {{else}}
                        <span class="wizard-char-name">{{row.label}}</span>
                        {{/if}}
                        <span class="wizard-char-mod">{{#if row.modifier}}{{#if (gt row.modifier 0)}}+{{/if}}{{row.modifier}}{{/if}}</span>
                        <span class="wizard-char-formula">{{#if row.rollable}}{{row.formula}}{{/if}}</span>
                        <input type="number" class="wizard-char-value" data-characteristic="{{row.key}}"
                               value="{{row.value}}" data-start="{{row.start}}"/>
                        {{!-- Only War (стр. 74): один результат можно перебросить, но новый
                              придётся оставить, даже если он хуже. --}}
                        {{#if ../charRerolls}}{{#if row.rollable}}
                        <button type="button" class="wizard-reroll" data-reroll="{{row.key}}" data-formula="{{row.formula}}"
                                title="{{localize "WIZARD.REROLL_HINT"}}"
                                {{#unless ../charRerollsLeft}}disabled{{/unless}}><i class="fas fa-dice-d10"></i></button>
                        {{/if}}{{/if}}
                    </div>
                    {{/each}}
                </div>
                {{#unless charPointBuy}}
                <div class="wizard-char-actions">
                    <button type="button" class="wizard-roll-all">{{localize "WIZARD.ROLL_ALL_BUTTON"}}</button>
                </div>
                {{/unless}}
                {{/if}}
            {{/if}}

            {{#if (eq step.kind "experience")}}
                {{!-- Пул и остаток — первое, что читает игрок: без них каждая цена ниже
                      висит в воздухе. --}}
                <div class="shop-ledger">
                    <div class="shop-ledger-cell">
                        <span class="shop-ledger-label">{{localize "WIZARD.SHOP_POOL"}}</span>
                        <span class="shop-ledger-value">{{experiencePool}}</span>
                    </div>
                    <div class="shop-ledger-cell">
                        <span class="shop-ledger-label">{{localize "WIZARD.SHOP_SPENT"}}</span>
                        <span class="shop-ledger-value">{{shopSpent}}</span>
                    </div>
                    <div class="shop-ledger-cell shop-ledger-remaining">
                        <span class="shop-ledger-label">{{localize "WIZARD.SHOP_REMAINING"}}</span>
                        <span class="shop-ledger-value">{{shopRemaining}}</span>
                    </div>
                </div>

                {{!-- Склонности плитками: по ним считается цена КАЖДОЙ покупки. В Black
                      Crusade их нет — там цену задаёт покровитель, его и показываем. --}}
                {{#if showAptitudes}}
                <div class="wizard-aptitudes">
                    <span class="wizard-choice-label">{{localize "WIZARD.APTITUDES"}}</span>
                    {{#each aptitudeChips as |aptitude|}}
                    <span class="wizard-aptitude">{{aptitude}}</span>
                    {{/each}}
                </div>
                {{else}}
                <div class="wizard-aptitudes">
                    <span class="wizard-choice-label">{{localize "WIZARD.PATRON"}}</span>
                    <span class="wizard-aptitude">{{shopPatron}}</span>
                </div>
                {{/if}}
                {{!-- Книга, стр. 79: повторная склонность не даётся второй раз, а меняется
                      на склонность характеристики, которой ещё нет. Выбирает игрок, и пока
                      он не выбрал, цены не окончательны — поэтому покупки ждут. --}}
                {{#if owedSlots.length}}
                <div class="shop-owed">
                    <p class="wizard-warn">{{localize "WIZARD.OWED_RULE"}}</p>
                    {{#each owedSlots as |slot|}}
                    <div class="shop-owed-row">
                        <span class="shop-name">{{slot.duplicate}}</span>
                        <span class="shop-step">{{slot.label}}</span>
                        <select data-owed-choice="{{@index}}">
                            {{#each slot.options as |option|}}<option value="{{option}}">{{option}}</option>{{/each}}
                        </select>
                        <button type="button" class="shop-buy" data-replace-aptitude="{{@index}}">{{localize "WIZARD.OWED_TAKE"}}</button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                {{#if replacementSlots.length}}
                <div class="shop-replacements">
                    <span class="wizard-choice-label">{{localize "WIZARD.OWED_REPLACED"}}</span>
                    {{#each replacementSlots as |slot|}}
                    <span class="shop-prereq met">{{slot.duplicate}} → {{slot.chosen}}
                        <button type="button" class="shop-undo" data-undo-replacement="{{@index}}"
                                title="{{localize "WIZARD.SHOP_REFUND"}}"><i class="fas fa-xmark"></i></button></span>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Лавки на вкладках: вместе они дали бы ленту из полутора сотен строк.
                      Психосилы — только у псайкера. --}}
                <nav class="shop-tabs">
                    {{#each shopTabs as |tab|}}
                    <button type="button" data-shop-tab="{{tab.key}}" class="{{#if tab.active}}active{{/if}}">{{tab.label}}</button>
                    {{/each}}
                </nav>

                {{#if (eq shopTab "characteristics")}}
                <div class="shop-list">
                    {{#each shopCharacteristics as |offer|}}
                    <div class="shop-row{{#if offer.maxed}} maxed{{/if}}">
                        <span class="shop-name">{{offer.label}}</span>
                        <span class="shop-step">{{#if offer.maxed}}{{localize "WIZARD.SHOP_MAXED"}}{{else}}{{offer.nextLabel}} +5{{/if}}</span>
                        <span class="shop-match" title="{{localize "WIZARD.SHOP_MATCH_HINT"}}">{{offer.matchText}}</span>
                        <span class="shop-cost">{{#unless offer.maxed}}{{offer.cost}}{{/unless}}</span>
                        <button type="button" class="shop-buy" data-buy-characteristic="{{offer.key}}"
                                {{#unless offer.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{#if (eq shopTab "skills")}}
                <div class="shop-list">
                    {{#each shopSkills as |offer|}}
                    <div class="shop-row{{#if offer.maxed}} maxed{{/if}}">
                        <span class="shop-name">{{offer.label}}</span>
                        <span class="shop-step">{{#if offer.maxed}}{{localize "WIZARD.SHOP_MAXED"}}{{else}}{{offer.currentLabel}} → {{offer.nextLabel}}{{/if}}</span>
                        <span class="shop-match" title="{{localize "WIZARD.SHOP_MATCH_HINT"}}">{{#if offer.relationLabel}}{{offer.relationLabel}}{{else}}{{offer.matched}}/2{{/if}}</span>
                        <span class="shop-cost">{{#unless offer.maxed}}{{offer.cost}}{{/unless}}</span>
                        <button type="button" class="shop-buy" data-buy-skill="{{offer.key}}" data-spec="{{offer.specKey}}"
                                {{#unless offer.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                    </div>
                    {{/each}}
                </div>
                {{!-- Новая специализация — по имени: их по двадцать на навык, и строка
                      «купить Known» в каждой была бы стеной. --}}
                <div class="shop-new-spec">
                    <span class="wizard-choice-label">{{localize "WIZARD.SHOP_NEW_SPECIALITY"}}</span>
                    <select class="shop-new-spec-skill">
                        {{#each shopSpecialistSkills as |skill|}}
                        <option value="{{skill.key}}">{{skill.label}}</option>
                        {{/each}}
                    </select>
                    <input type="text" class="shop-new-spec-name" placeholder="{{localize "WIZARD.SHOP_SPECIALITY_NAME"}}"/>
                    <button type="button" class="shop-buy" data-buy-speciality>{{localize "WIZARD.SHOP_BUY"}}</button>
                </div>
                {{/if}}

                {{#if (eq shopTab "talents")}}
                <div class="shop-filters">
                    <input type="text" class="shop-talent-search" value="{{talentFilter}}"
                           placeholder="{{localize "WIZARD.SHOP_SEARCH"}}"/>
                    <select class="shop-talent-tier">
                        <option value="0" {{#if (eq talentTier 0)}}selected{{/if}}>{{localize "WIZARD.SHOP_ALL_TIERS"}}</option>
                        <option value="1" {{#if (eq talentTier 1)}}selected{{/if}}>{{localize "WIZARD.SHOP_TIER"}} 1</option>
                        <option value="2" {{#if (eq talentTier 2)}}selected{{/if}}>{{localize "WIZARD.SHOP_TIER"}} 2</option>
                        <option value="3" {{#if (eq talentTier 3)}}selected{{/if}}>{{localize "WIZARD.SHOP_TIER"}} 3</option>
                    </select>
                </div>
                <div class="shop-list">
                    {{#each shopTalents as |offer|}}
                    <div class="shop-row shop-talent{{#if offer.blocked}} blocked{{/if}}">
                        <div class="shop-talent-head">
                            <button type="button" class="shop-name shop-read" data-read-talent="{{offer.uuid}}"
                                    aria-expanded="{{#if offer.open}}true{{else}}false{{/if}}"
                                    title="{{localize "WIZARD.SHOP_READ"}}"><i class="fas fa-book-open"></i>{{offer.name}}</button>
                            <span class="shop-step">{{localize "WIZARD.SHOP_TIER"}} {{offer.tier}}</span>
                            <span class="shop-match" title="{{offer.aptitudeText}}">{{#if offer.relationLabel}}{{offer.relationLabel}}{{else}}{{offer.matched}}/2{{/if}}</span>
                            <span class="shop-cost">{{offer.cost}}</span>
                            <button type="button" class="shop-buy" data-buy-talent="{{offer.uuid}}"
                                    {{#unless offer.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                        </div>
                        {{#if offer.prerequisites.length}}
                        <div class="shop-prerequisites">
                            {{#each offer.prerequisites as |check|}}
                            <span class="shop-prereq {{check.status}}">{{check.text}}</span>
                            {{/each}}
                        </div>
                        {{/if}}
                        {{#if offer.specialist}}
                        <input type="text" class="shop-talent-spec" data-talent-spec="{{offer.uuid}}"
                               placeholder="{{localize "WIZARD.SHOP_SPECIALISATION"}}"/>
                        {{/if}}
                        {{!-- Текст книги — тем же листом, что у происхождений: игрок уже знает,
                              как он читается. Полная карточка — кнопкой, для ссылок и эффектов. --}}
                        {{#if offer.book}}
                        <section class="wizard-book shop-book">
                            {{#if offer.book.benefit}}
                            <p class="shop-book-benefit"><b>{{localize "WIZARD.SHOP_BENEFIT"}}</b> {{offer.book.benefit}}</p>
                            {{/if}}
                            <div class="wizard-book-text">{{{offer.book.description}}}</div>
                            {{#if offer.book.effect}}<div class="wizard-book-text">{{{offer.book.effect}}}</div>{{/if}}
                            <div class="shop-book-footer">
                                <span class="wizard-book-source">{{offer.book.source}}</span>
                                <button type="button" class="shop-buy" data-open-talent="{{offer.uuid}}">
                                    <i class="fas fa-up-right-from-square"></i> {{localize "WIZARD.SHOP_OPEN_SHEET"}}</button>
                            </div>
                        </section>
                        {{/if}}
                    </div>
                    {{else}}
                    <p class="wizard-note">{{localize "WIZARD.SHOP_NO_TALENTS"}}</p>
                    {{/each}}
                </div>
                {{/if}}

                {{#if (eq shopTab "elite")}}
                <div class="shop-list">
                    {{#each shopElite as |offer|}}
                    <div class="shop-row shop-talent{{#if offer.blocked}} blocked{{/if}}">
                        <div class="shop-talent-head">
                            <span class="shop-name">{{offer.name}}</span>
                            <span class="shop-step">{{#if offer.owned}}{{localize "WIZARD.SHOP_OWNED"}}{{else}}{{#if offer.excluded}}{{localize "WIZARD.SHOP_EXCLUDED"}}{{else}}p. {{offer.page}}{{/if}}{{/if}}</span>
                            <span class="shop-match"></span>
                            <span class="shop-cost">{{offer.cost}}</span>
                            <button type="button" class="shop-buy" data-buy-elite="{{offer.key}}"
                                    {{#unless offer.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                        </div>
                        {{#if offer.prerequisites.length}}
                        <div class="shop-prerequisites">
                            {{#each offer.prerequisites as |check|}}
                            <span class="shop-prereq {{check.status}}">{{check.text}}</span>
                            {{/each}}
                        </div>
                        {{/if}}
                        <p class="shop-rules">{{offer.rules}}</p>
                    </div>
                    {{/each}}
                </div>
                <p class="wizard-note">{{localize "WIZARD.ELITE_GM"}}</p>
                {{/if}}

                {{#if (eq shopTab "advances")}}
                {{!-- Продвижения специальности: приказы Comrade и то, что книга даёт
                      только этой специальности. --}}
                <div class="shop-list">
                    {{#each shopAdvances as |offer|}}
                    <div class="shop-row shop-talent{{#if offer.owned}} maxed{{/if}}">
                        <div class="shop-talent-head">
                            <span class="shop-name">{{offer.name}}</span>
                            <span class="shop-step">{{offer.type}}</span>
                            {{!-- У Deathwatch важно, ИЗ КАКОГО списка строка: орденская
                                  не требует ранга, а список самого Караула при создании
                                  закрыт (стр. 58). --}}
                            <span class="shop-match">{{offer.sourceLabel}}</span>
                            <span class="shop-cost">{{offer.cost}}</span>
                            <button type="button" class="shop-buy" data-buy-advance="{{offer.name}}"
                                    {{#unless offer.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                        </div>
                        {{#if offer.effect}}<p class="shop-rules">{{offer.effect}}</p>{{/if}}
                        {{#if offer.prerequisites}}<p class="shop-prerequisites"><span class="shop-prereq">{{offer.prerequisites}}</span></p>{{/if}}
                        {{#if offer.note}}<p class="wizard-warn">{{offer.note}}</p>{{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{#if (eq shopTab "psychic")}}
                {{#if shopFreePowerExperience}}
                <p class="wizard-note">{{localize "WIZARD.SHOP_FREE_POWERS"}} <b>{{shopFreePowerExperience}}</b></p>
                {{/if}}
                {{!-- Рейтинг: 200 × новый рейтинг (стр. 90). Силы: путь по дереву дисциплины
                      плюс предпосылки (стр. 199); цена — Value из статьи силы. --}}
                <div class="shop-list">
                    <div class="shop-row{{#if shopPsy.maxed}} maxed{{/if}}">
                        <span class="shop-name">{{localize "WIZARD.SHOP_PSY_RATING"}}</span>
                        <span class="shop-step">{{#if shopPsy.maxed}}{{localize "WIZARD.SHOP_MAXED"}}{{else}}{{shopPsy.rating}} → {{shopPsy.next}}{{/if}}</span>
                        <span class="shop-match"></span>
                        <span class="shop-cost">{{#unless shopPsy.maxed}}{{shopPsy.cost}}{{/unless}}</span>
                        <button type="button" class="shop-buy" data-buy-psy-rating
                                {{#unless shopPsy.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                    </div>
                </div>
                {{#each shopDisciplines as |discipline|}}
                <section class="shop-discipline">
                    <h3 class="shop-discipline-title">{{discipline.label}}{{#if discipline.page}} <span class="shop-step">p. {{discipline.page}}</span>{{/if}}</h3>
                    <div class="shop-list">
                        {{#each discipline.powers as |offer|}}
                        <div class="shop-row shop-talent{{#if offer.blocked}} blocked{{/if}}{{#if offer.owned}} maxed{{/if}}">
                            <div class="shop-talent-head">
                                {{#if offer.uuid}}
                                <button type="button" class="shop-name shop-read" data-read-talent="{{offer.uuid}}"
                                        aria-expanded="{{#if offer.open}}true{{else}}false{{/if}}"
                                        title="{{localize "WIZARD.SHOP_READ"}}"><i class="fas fa-book-open"></i>{{offer.name}}</button>
                                {{else}}
                                <span class="shop-name">{{offer.name}}</span>
                                {{/if}}
                                <span class="shop-step">{{#if offer.owned}}{{localize "WIZARD.SHOP_OWNED"}}{{/if}}</span>
                                <span class="shop-match">{{#if offer.gifted}}{{localize "WIZARD.SHOP_GIFTED"}}{{/if}}</span>
                                <span class="shop-cost">{{offer.cost}}</span>
                                <button type="button" class="shop-buy" data-buy-power="{{offer.uuid}}"
                                        {{#unless offer.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                            </div>
                            {{#if offer.showChecks}}
                            <div class="shop-prerequisites">
                                {{#unless offer.accessible}}
                                <span class="shop-prereq unmet">{{localize "WIZARD.SHOP_TREE_NEEDS"}} {{offer.parentsText}}</span>
                                {{/unless}}
                                {{#each offer.prerequisites as |check|}}
                                <span class="shop-prereq {{check.status}}">{{check.text}}</span>
                                {{/each}}
                            </div>
                            {{/if}}
                            {{#if offer.book}}
                            <section class="wizard-book shop-book">
                                <div class="wizard-book-text">{{{offer.book.description}}}</div>
                                {{#if offer.book.effect}}<div class="wizard-book-text">{{{offer.book.effect}}}</div>{{/if}}
                                <div class="shop-book-footer">
                                    <span class="wizard-book-source">{{offer.book.source}}</span>
                                    <button type="button" class="shop-buy" data-open-talent="{{offer.uuid}}">
                                        <i class="fas fa-up-right-from-square"></i> {{localize "WIZARD.SHOP_OPEN_SHEET"}}</button>
                                </div>
                            </section>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                </section>
                {{/each}}
                {{/if}}

                {{!-- Журнал покупок этого прохода. Возвращается любая, но ступень лестницы —
                      только верхняя: так устроена книга. --}}
                {{#if shopPurchases.length}}
                <div class="shop-purchases">
                    <span class="wizard-choice-label">{{localize "WIZARD.SHOP_PURCHASES"}}</span>
                    {{#each shopPurchases as |record|}}
                    <div class="shop-purchase">
                        {{#if record.readable}}
                        <button type="button" class="shop-name shop-read" data-open-item="{{record.itemId}}"
                                title="{{localize "WIZARD.SHOP_OPEN_SHEET"}}"><i class="fas fa-book-open"></i>{{record.label}}</button>
                        {{else}}
                        <span class="shop-name">{{record.label}}</span>
                        {{/if}}
                        <span class="shop-cost">{{record.cost}}</span>
                        <button type="button" class="shop-refund" data-refund="{{record.index}}"
                                title="{{localize "WIZARD.SHOP_REFUND"}}"><i class="fas fa-rotate-left"></i></button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

            {{/if}}

{{#if (eq step.kind "equipment")}}
                {{!-- Стр. 82: сверх выданного фоном — столько предметов Арсенала, каков бонус
                      Влияния, каждый доступности Scarce или лучше. Выбор, а не бросок. --}}
                <div class="shop-ledger shop-ledger-two">
                    <div class="shop-ledger-cell">
                        <span class="shop-ledger-label">{{equipmentAllowanceLabel}}</span>
                        <span class="shop-ledger-value">{{equipmentAllowance}}</span>
                    </div>
                    <div class="shop-ledger-cell shop-ledger-remaining">
                        <span class="shop-ledger-label">{{localize "WIZARD.SHOP_REMAINING"}}</span>
                        <span class="shop-ledger-value">{{equipmentLeft}}</span>
                    </div>
                </div>
                <p class="wizard-note">{{equipmentRule}}</p>

                {{#if equipmentPicks.length}}
                <div class="shop-purchases">
                    <span class="wizard-choice-label">{{localize "WIZARD.EQUIPMENT_TAKEN"}}</span>
                    {{#each equipmentPicks as |pick|}}
                    <div class="shop-purchase">
                        {{#if pick.present}}
                        <button type="button" class="shop-name shop-read" data-open-item="{{pick.itemId}}"
                                title="{{localize "WIZARD.SHOP_OPEN_SHEET"}}"><i class="fas fa-book-open"></i>{{pick.name}}</button>
                        {{else}}
                        <span class="shop-name">{{pick.name}}</span>
                        {{/if}}
                        <span class="shop-cost"></span>
                        <button type="button" class="shop-refund" data-drop-equipment="{{pick.index}}"
                                title="{{localize "WIZARD.SHOP_REFUND"}}"><i class="fas fa-rotate-left"></i></button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                <div class="shop-filters">
                    <input type="text" class="equipment-search shop-talent-search" value="{{equipmentFilter}}"
                           placeholder="{{localize "WIZARD.EQUIPMENT_SEARCH"}}"/>
                    <select class="equipment-type shop-talent-tier">
                        <option value="">{{localize "WIZARD.EQUIPMENT_ALL_TYPES"}}</option>
                        {{#each equipmentTypes as |type|}}
                        <option value="{{type.key}}" {{#if type.selected}}selected{{/if}}>{{type.label}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="shop-list">
                    {{#each equipmentOffers as |offer|}}
                    <div class="shop-row shop-talent{{#if offer.picked}} maxed{{/if}}">
                        <div class="shop-talent-head shop-equipment-head">
                            <button type="button" class="shop-name shop-read" data-read-talent="{{offer.uuid}}"
                                    aria-expanded="{{#if offer.open}}true{{else}}false{{/if}}"
                                    title="{{localize "WIZARD.SHOP_READ"}}"><i class="fas fa-book-open"></i>{{offer.name}}</button>
                            <span class="shop-step">{{offer.typeLabel}}</span>
                            <span class="shop-availability">{{offer.availabilityLabel}}</span>
                            <button type="button" class="shop-buy" data-take-equipment="{{offer.uuid}}"
                                    {{#unless offer.allowed}}disabled{{/unless}}>{{localize "WIZARD.OWED_TAKE"}}</button>
                        </div>
                        {{#if offer.book}}
                        <section class="wizard-book shop-book">
                            <div class="wizard-book-text">{{{offer.book.description}}}</div>
                            <div class="shop-book-footer">
                                <span class="wizard-book-source">{{offer.book.source}}</span>
                                <button type="button" class="shop-buy" data-open-talent="{{offer.uuid}}">
                                    <i class="fas fa-up-right-from-square"></i> {{localize "WIZARD.SHOP_OPEN_SHEET"}}</button>
                            </div>
                        </section>
                        {{/if}}
                    </div>
                    {{else}}
                    <p class="wizard-note">{{localize "WIZARD.SHOP_NO_TALENTS"}}</p>
                    {{/each}}
                </div>
            {{/if}}

            {{!-- Стадия 4 (стр. 71-75): Гордыня, Позор и Стремление. Три таблицы одной
                  панелью — это один разговор о том, кто этот еретик. Книга разрешает и
                  выбрать, и бросить d10, поэтому кость стоит рядом со списком. --}}
            {{#if (eq step.kind "passions")}}
                {{#each passionGroups as |group|}}
                <div class="wizard-passion" data-passion="{{group.id}}">
                    {{#if group.originLocked}}
                    <p class="wizard-locked">{{group.label}}: <b>{{group.originName}}</b></p>
                    {{else}}
                    <div class="form-group">
                        <label>{{group.label}}</label>
                        <div class="form-fields">
                            <select data-origin-step="{{group.id}}">
                                <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                                {{#each group.originOptions as |o|}}
                                <option value="{{o.uuid}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>
                                {{/each}}
                            </select>
                            <button type="button" class="shop-buy" data-roll-passion="{{group.id}}"
                                    data-passion-stage="{{group.id}}">{{localize "WIZARD.ROLL"}}</button>
                        </div>
                    </div>
                    <div class="wizard-choice-rows">{{{group.choiceRows}}}</div>
                    {{/if}}
                    {{#if group.originBook}}
                    <div class="wizard-book">
                        <div class="wizard-book-text">{{{group.originBook.description}}}</div>
                        {{#if group.originBook.summary.length}}
                        <ul class="wizard-book-summary">
                            {{#each group.originBook.summary as |line|}}<li>{{line}}</li>{{/each}}
                        </ul>
                        {{/if}}
                        {{#if group.originBook.source}}
                        <p class="wizard-book-source">{{group.originBook.source}}</p>
                        {{/if}}
                    </div>
                    {{/if}}
                </div>
                {{/each}}
            {{/if}}

            {{#if (eq step.kind "comrade")}}
                {{!-- Стадии 4 и 5 (стр. 104-110): характер персонажа и его Comrade.
                      Имя пишется от руки — книжные таблицы имён это списки для вдохновения. --}}
                <div class="wizard-choice">
                    <span class="wizard-choice-label">{{localize "WIZARD.DEMEANOUR"}}</span>
                    <input type="text" data-bio-field="demeanour" value="{{characterDemeanour}}"/>
                    <button type="button" class="shop-buy" data-roll-demeanour="demeanour">{{localize "WIZARD.ROLL"}}</button>
                </div>

                {{#if comradeNone}}
                <p class="wizard-note">{{localize "WIZARD.COMRADE_NONE"}} <b>{{comradeSpeciality}}</b></p>
                {{else}}
                <div class="wizard-choice">
                    <span class="wizard-choice-label">{{#if comradeIsServitor}}{{localize "WIZARD.SERVITOR_NAME"}}{{else}}{{localize "WIZARD.COMRADE_NAME"}}{{/if}}</span>
                    <input type="text" data-bio-field="comrade" value="{{comradeName}}"/>
                </div>
                <div class="wizard-choice">
                    <span class="wizard-choice-label">{{localize "WIZARD.COMRADE_DEMEANOUR"}}</span>
                    <input type="text" data-bio-field="comradeDemeanour" value="{{comradeDemeanour}}"/>
                    <button type="button" class="shop-buy" data-roll-demeanour="comradeDemeanour">{{localize "WIZARD.ROLL"}}</button>
                </div>
                {{/if}}
            {{/if}}

            {{!-- Стадия 7 (стр. 84): чей ты. Ни костей, ни трат — но с этой минуты
                  меняется цена каждого следующего улучшения. --}}
            {{#if (eq step.kind "darkGods")}}
                <p class="wizard-note">{{localize "WIZARD.DARK_GODS_HINT"}} <b>{{godChosen}}</b></p>
                <div class="shop-list">
                    {{#each godOptions as |god|}}
                    <div class="shop-row{{#if god.selected}} maxed{{/if}}">
                        <span class="shop-name">{{god.label}}</span>
                        <span class="shop-step">{{god.relation}}</span>
                        <span class="shop-match">{{#if god.count}}{{god.count}}{{/if}}</span>
                        <span class="shop-cost"></span>
                        <button type="button" class="shop-buy" data-choose-god="{{god.key}}"
                                {{#if god.selected}}disabled{{/if}}>{{localize "WIZARD.DARK_GODS_TAKE"}}</button>
                    </div>
                    {{/each}}
                </div>
                {{#if godLeaningDiffers}}
                <p class="wizard-warn">{{localize "WIZARD.DARK_GODS_LEANING"}} <b>{{godLeaning}}</b></p>
                {{/if}}
            {{/if}}

            {{#if (eq step.kind "divination")}}
                {{#if divinationDrawn}}
                {{!-- Пророчество — цитата, эффект под ним отдельной строкой:
                      первое читают, второе применяется. --}}
                <blockquote class="wizard-divination">{{divinationName}}</blockquote>
                <p class="wizard-book-text">{{divinationText}}</p>
                {{#if divinationEffect}}
                <ul class="wizard-book-grants">
                    {{#each divinationEffect as |line|}}<li>{{line}}</li>{{/each}}
                </ul>
                {{/if}}
                <div class="wizard-char-actions">
                    <button type="button" class="wizard-reroll-divination">{{localize "WIZARD.REROLL"}}</button>
                </div>
                {{else}}
                <p class="wizard-note">{{localize "WIZARD.DIVINATION_HINT"}}</p>
                <div class="wizard-char-actions">
                    <button type="button" class="wizard-roll-divination">{{localize "WIZARD.ROLL_DIVINATION"}}</button>
                </div>
                {{/if}}
            {{/if}}
        </div>
        {{/unless}}
    </div>

    <footer class="wizard-footer">
        <button type="button" data-action="wizard-back" {{#if backDisabled}}disabled{{/if}}>
            {{localize "WIZARD.BACK"}}
        </button>
        <button type="button" data-action="wizard-next" {{#if nextDisabled}}disabled{{/if}}>
            {{#if isLastStep}}{{localize "WIZARD.FINISH"}}{{else}}{{localize "WIZARD.NEXT"}}{{/if}}
        </button>
    </footer>
</div>
{{/if}}
