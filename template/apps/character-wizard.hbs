{{#if missing}}
<div class="wizard-missing">{{localize "WIZARD.NO_ACTOR"}}</div>
{{else}}
<div class="character-wizard-body">
    {{#if rulesetChosen}}
    <nav class="wizard-steps">
        {{#each steps as |s|}}
        <span class="wizard-step-chip{{#if s.active}} active{{/if}}{{#if s.done}} done{{/if}}">{{s.label}}</span>
        {{/each}}
    </nav>
    {{/if}}

    <div class="wizard-step-body">
        {{#unless rulesetChosen}}
        <div class="form-group">
            <label>{{localize "WIZARD.RULESET"}}</label>
            <div class="form-fields">
                <select class="wizard-ruleset">
                    <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                    {{#each rulesets as |r|}}
                    <option value="{{r.key}}" {{#if r.selected}}selected{{/if}}>{{r.label}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
        {{!-- Книги, правила создания которых ещё не сверены с текстом: вести по ним
              Мастер не станет, и молчать об этом нельзя. --}}
        {{#if unaudited}}
        <p class="wizard-note">{{localize "WIZARD.UNAUDITED"}} {{unaudited}}</p>
        {{/if}}
        {{else}}
        <h1 class="wizard-step-title">{{step.label}}</h1>
        <div class="wizard-step-content" data-step="{{step.id}}" data-kind="{{step.kind}}">
            {{#if (eq step.kind "origin")}}
                {{#if originLocked}}
                {{!-- Шаг уже закреплён. Переспросить можно только через «Назад»,
                      который снимет выданное — иначе выдачи наложились бы. --}}
                <p class="wizard-locked">{{localize "WIZARD.LOCKED"}} <b>{{originName}}</b></p>
                {{else}}
                <div class="form-group">
                    <label>{{step.label}}</label>
                    <div class="form-fields">
                        <select data-origin-step="{{step.id}}">
                            <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                            {{#each originOptions as |o|}}
                            <option value="{{o.uuid}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="wizard-choice-rows">{{{choiceRows}}}</div>
                {{/if}}

                {{!-- Текст книги под выбранным. Ради него всё и затевалось: игрок
                      должен читать, что он берёт, а не угадывать по названию. --}}
                {{#if originBook}}
                <section class="wizard-book">
                    <div class="wizard-book-text">{{{originBook.description}}}</div>
                    {{#each originBook.bonuses as |bonus|}}
                    <div class="wizard-book-bonus">
                        <h2>{{bonus.name}}</h2>
                        {{{bonus.description}}}
                    </div>
                    {{/each}}
                    {{#if originBook.summary.length}}
                    <ul class="wizard-book-grants">
                        {{#each originBook.summary as |line|}}<li>{{line}}</li>{{/each}}
                    </ul>
                    {{/if}}
                    {{#if originBook.source}}
                    <p class="wizard-book-source">{{originBook.source}}</p>
                    {{/if}}
                </section>
                {{/if}}
            {{/if}}

            {{#if (eq step.kind "characteristics")}}
                {{#if charLocked}}
                {{!-- Уже сгенерировано. «Назад» снимает запись, и шаг можно пройти заново. --}}
                <p class="wizard-locked">{{localize "WIZARD.CHAR_LOCKED"}}</p>
                {{#if charBlessing}}<p class="wizard-note">{{charBlessing}}</p>{{/if}}
                {{else}}
                <div class="form-group">
                    <label>{{localize "WIZARD.METHOD_LABEL"}}</label>
                    <div class="form-fields">
                        <select class="wizard-char-method">
                            {{#each charMethods as |m|}}
                            <option value="{{m.key}}" {{#if m.selected}}selected{{/if}}>{{m.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                {{#if charPointBuy}}
                <p class="wizard-note">{{localize "WIZARD.POINT_BUY_HINT"}}
                    <span class="wizard-budget" data-spent>0</span> / {{charBudget}}</p>
                {{/if}}
                {{!-- Строка как на анкете: имя — спуск броска, значение крупное и несёт
                      строку, формула стоит тихой подписью. --}}
                <div class="wizard-chars">
                    {{#each charRows as |row|}}
                    <div class="wizard-char">
                        {{#if ../charPointBuy}}
                        <span class="wizard-char-name">{{row.label}}</span>
                        {{else}}
                        <button type="button" class="wizard-roll" data-roll="{{row.key}}"
                                data-formula="{{row.formula}}" title="{{row.formula}}">{{row.label}}</button>
                        {{/if}}
                        <span class="wizard-char-mod">{{#if row.modifier}}{{#if (gt row.modifier 0)}}+{{/if}}{{row.modifier}}{{/if}}</span>
                        <span class="wizard-char-formula">{{#unless ../charPointBuy}}{{row.formula}}{{/unless}}</span>
                        <input type="number" class="wizard-char-value" data-characteristic="{{row.key}}"
                               value="{{row.value}}" data-start="{{row.start}}"/>
                    </div>
                    {{/each}}
                </div>
                {{#unless charPointBuy}}
                <div class="wizard-char-actions">
                    <button type="button" class="wizard-roll-all">{{localize "WIZARD.ROLL_ALL_BUTTON"}}</button>
                </div>
                {{/unless}}
                {{/if}}
            {{/if}}

            {{#if (eq step.kind "experience")}}
                {{!-- Пул и остаток — первое, что читает игрок: без них каждая цена ниже
                      висит в воздухе. --}}
                <div class="shop-ledger">
                    <div class="shop-ledger-cell">
                        <span class="shop-ledger-label">{{localize "WIZARD.SHOP_POOL"}}</span>
                        <span class="shop-ledger-value">{{experiencePool}}</span>
                    </div>
                    <div class="shop-ledger-cell">
                        <span class="shop-ledger-label">{{localize "WIZARD.SHOP_SPENT"}}</span>
                        <span class="shop-ledger-value">{{shopSpent}}</span>
                    </div>
                    <div class="shop-ledger-cell shop-ledger-remaining">
                        <span class="shop-ledger-label">{{localize "WIZARD.SHOP_REMAINING"}}</span>
                        <span class="shop-ledger-value">{{shopRemaining}}</span>
                    </div>
                </div>

                {{!-- Склонности плитками: по ним считается цена КАЖДОЙ покупки. --}}
                <div class="wizard-aptitudes">
                    <span class="wizard-choice-label">{{localize "WIZARD.APTITUDES"}}</span>
                    {{#each aptitudeChips as |aptitude|}}
                    <span class="wizard-aptitude">{{aptitude}}</span>
                    {{/each}}
                </div>
                {{#if owedAptitudes}}
                {{!-- Книга, стр. 79: повторная склонность не пропадает, а меняется
                      на другую характеристическую. Выбирает игрок. --}}
                <p class="wizard-warn">{{localize "WIZARD.OWED_APTITUDES"}} {{owedAptitudes}}</p>
                {{/if}}

                {{!-- Три лавки на вкладках: вместе они дали бы ленту из полутора сотен строк. --}}
                <nav class="shop-tabs">
                    <button type="button" data-shop-tab="characteristics"
                            class="{{#if (eq shopTab "characteristics")}}active{{/if}}">{{localize "WIZARD.SHOP_TAB_CHARACTERISTICS"}}</button>
                    <button type="button" data-shop-tab="skills"
                            class="{{#if (eq shopTab "skills")}}active{{/if}}">{{localize "WIZARD.SHOP_TAB_SKILLS"}}</button>
                    <button type="button" data-shop-tab="talents"
                            class="{{#if (eq shopTab "talents")}}active{{/if}}">{{localize "WIZARD.SHOP_TAB_TALENTS"}}</button>
                </nav>

                {{#if (eq shopTab "characteristics")}}
                <div class="shop-list">
                    {{#each shopCharacteristics as |offer|}}
                    <div class="shop-row{{#if offer.maxed}} maxed{{/if}}">
                        <span class="shop-name">{{offer.label}}</span>
                        <span class="shop-step">{{#if offer.maxed}}{{localize "WIZARD.SHOP_MAXED"}}{{else}}{{offer.nextLabel}} +5{{/if}}</span>
                        <span class="shop-match" title="{{localize "WIZARD.SHOP_MATCH_HINT"}}">{{offer.matched}}/2</span>
                        <span class="shop-cost">{{#unless offer.maxed}}{{offer.cost}}{{/unless}}</span>
                        <button type="button" class="shop-buy" data-buy-characteristic="{{offer.key}}"
                                {{#unless offer.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{#if (eq shopTab "skills")}}
                <div class="shop-list">
                    {{#each shopSkills as |offer|}}
                    <div class="shop-row{{#if offer.maxed}} maxed{{/if}}">
                        <span class="shop-name">{{offer.label}}</span>
                        <span class="shop-step">{{#if offer.maxed}}{{localize "WIZARD.SHOP_MAXED"}}{{else}}{{offer.currentLabel}} → {{offer.nextLabel}}{{/if}}</span>
                        <span class="shop-match" title="{{localize "WIZARD.SHOP_MATCH_HINT"}}">{{offer.matched}}/2</span>
                        <span class="shop-cost">{{#unless offer.maxed}}{{offer.cost}}{{/unless}}</span>
                        <button type="button" class="shop-buy" data-buy-skill="{{offer.key}}" data-spec="{{offer.specKey}}"
                                {{#unless offer.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                    </div>
                    {{/each}}
                </div>
                {{!-- Новая специализация — по имени: их по двадцать на навык, и строка
                      «купить Known» в каждой была бы стеной. --}}
                <div class="shop-new-spec">
                    <span class="wizard-choice-label">{{localize "WIZARD.SHOP_NEW_SPECIALITY"}}</span>
                    <select class="shop-new-spec-skill">
                        {{#each shopSpecialistSkills as |skill|}}
                        <option value="{{skill.key}}">{{skill.label}}</option>
                        {{/each}}
                    </select>
                    <input type="text" class="shop-new-spec-name" placeholder="{{localize "WIZARD.SHOP_SPECIALITY_NAME"}}"/>
                    <button type="button" class="shop-buy" data-buy-speciality>{{localize "WIZARD.SHOP_BUY"}}</button>
                </div>
                {{/if}}

                {{#if (eq shopTab "talents")}}
                <div class="shop-filters">
                    <input type="text" class="shop-talent-search" value="{{talentFilter}}"
                           placeholder="{{localize "WIZARD.SHOP_SEARCH"}}"/>
                    <select class="shop-talent-tier">
                        <option value="0" {{#if (eq talentTier 0)}}selected{{/if}}>{{localize "WIZARD.SHOP_ALL_TIERS"}}</option>
                        <option value="1" {{#if (eq talentTier 1)}}selected{{/if}}>{{localize "WIZARD.SHOP_TIER"}} 1</option>
                        <option value="2" {{#if (eq talentTier 2)}}selected{{/if}}>{{localize "WIZARD.SHOP_TIER"}} 2</option>
                        <option value="3" {{#if (eq talentTier 3)}}selected{{/if}}>{{localize "WIZARD.SHOP_TIER"}} 3</option>
                    </select>
                </div>
                <div class="shop-list">
                    {{#each shopTalents as |offer|}}
                    <div class="shop-row shop-talent{{#if offer.blocked}} blocked{{/if}}">
                        <div class="shop-talent-head">
                            <button type="button" class="shop-name shop-read" data-read-talent="{{offer.uuid}}"
                                    aria-expanded="{{#if offer.open}}true{{else}}false{{/if}}"
                                    title="{{localize "WIZARD.SHOP_READ"}}"><i class="fas fa-book-open"></i>{{offer.name}}</button>
                            <span class="shop-step">{{localize "WIZARD.SHOP_TIER"}} {{offer.tier}}</span>
                            <span class="shop-match" title="{{offer.aptitudeText}}">{{offer.matched}}/2</span>
                            <span class="shop-cost">{{offer.cost}}</span>
                            <button type="button" class="shop-buy" data-buy-talent="{{offer.uuid}}"
                                    {{#unless offer.affordable}}disabled{{/unless}}>{{localize "WIZARD.SHOP_BUY"}}</button>
                        </div>
                        {{#if offer.prerequisites.length}}
                        <div class="shop-prerequisites">
                            {{#each offer.prerequisites as |check|}}
                            <span class="shop-prereq {{check.status}}">{{check.text}}</span>
                            {{/each}}
                        </div>
                        {{/if}}
                        {{#if offer.specialist}}
                        <input type="text" class="shop-talent-spec" data-talent-spec="{{offer.uuid}}"
                               placeholder="{{localize "WIZARD.SHOP_SPECIALISATION"}}"/>
                        {{/if}}
                        {{!-- Текст книги — тем же листом, что у происхождений: игрок уже знает,
                              как он читается. Полная карточка — кнопкой, для ссылок и эффектов. --}}
                        {{#if offer.book}}
                        <section class="wizard-book shop-book">
                            {{#if offer.book.benefit}}
                            <p class="shop-book-benefit"><b>{{localize "WIZARD.SHOP_BENEFIT"}}</b> {{offer.book.benefit}}</p>
                            {{/if}}
                            <div class="wizard-book-text">{{{offer.book.description}}}</div>
                            <div class="shop-book-footer">
                                <span class="wizard-book-source">{{offer.book.source}}</span>
                                <button type="button" class="shop-buy" data-open-talent="{{offer.uuid}}">
                                    <i class="fas fa-up-right-from-square"></i> {{localize "WIZARD.SHOP_OPEN_SHEET"}}</button>
                            </div>
                        </section>
                        {{/if}}
                    </div>
                    {{else}}
                    <p class="wizard-note">{{localize "WIZARD.SHOP_NO_TALENTS"}}</p>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Журнал покупок этого прохода. Возвращается любая, но ступень лестницы —
                      только верхняя: так устроена книга. --}}
                {{#if shopPurchases.length}}
                <div class="shop-purchases">
                    <span class="wizard-choice-label">{{localize "WIZARD.SHOP_PURCHASES"}}</span>
                    {{#each shopPurchases as |record|}}
                    <div class="shop-purchase">
                        {{#if record.readable}}
                        <button type="button" class="shop-name shop-read" data-open-item="{{record.itemId}}"
                                title="{{localize "WIZARD.SHOP_OPEN_SHEET"}}"><i class="fas fa-book-open"></i>{{record.label}}</button>
                        {{else}}
                        <span class="shop-name">{{record.label}}</span>
                        {{/if}}
                        <span class="shop-cost">{{record.cost}}</span>
                        <button type="button" class="shop-refund" data-refund="{{record.index}}"
                                title="{{localize "WIZARD.SHOP_REFUND"}}"><i class="fas fa-rotate-left"></i></button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                <p class="wizard-note">{{localize "WIZARD.ACQUISITIONS"}} <b>{{influenceBonus}}</b></p>
            {{/if}}

{{#if (eq step.kind "divination")}}
                {{#if divinationDrawn}}
                {{!-- Пророчество — цитата, эффект под ним отдельной строкой:
                      первое читают, второе применяется. --}}
                <blockquote class="wizard-divination">{{divinationName}}</blockquote>
                <p class="wizard-book-text">{{divinationText}}</p>
                {{#if divinationEffect}}
                <ul class="wizard-book-grants">
                    {{#each divinationEffect as |line|}}<li>{{line}}</li>{{/each}}
                </ul>
                {{/if}}
                <div class="wizard-char-actions">
                    <button type="button" class="wizard-reroll-divination">{{localize "WIZARD.REROLL"}}</button>
                </div>
                {{else}}
                <p class="wizard-note">{{localize "WIZARD.DIVINATION_HINT"}}</p>
                <div class="wizard-char-actions">
                    <button type="button" class="wizard-roll-divination">{{localize "WIZARD.ROLL_DIVINATION"}}</button>
                </div>
                {{/if}}
            {{/if}}
        </div>
        {{/unless}}
    </div>

    <footer class="wizard-footer">
        <button type="button" data-action="wizard-back" {{#if backDisabled}}disabled{{/if}}>
            {{localize "WIZARD.BACK"}}
        </button>
        <button type="button" data-action="wizard-next" {{#if nextDisabled}}disabled{{/if}}>
            {{#if isLastStep}}{{localize "WIZARD.FINISH"}}{{else}}{{localize "WIZARD.NEXT"}}{{/if}}
        </button>
    </footer>
</div>
{{/if}}
