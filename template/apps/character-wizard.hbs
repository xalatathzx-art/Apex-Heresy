{{#if missing}}
<div class="wizard-missing">{{localize "WIZARD.NO_ACTOR"}}</div>
{{else}}
<div class="character-wizard-body">
    {{#if rulesetChosen}}
    <nav class="wizard-steps">
        {{#each steps as |s|}}
        <span class="wizard-step-chip{{#if s.active}} active{{/if}}{{#if s.done}} done{{/if}}">{{s.label}}</span>
        {{/each}}
    </nav>
    {{/if}}

    <div class="wizard-step-body">
        {{#unless rulesetChosen}}
        <div class="form-group">
            <label>{{localize "WIZARD.RULESET"}}</label>
            <div class="form-fields">
                <select class="wizard-ruleset">
                    <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                    {{#each rulesets as |r|}}
                    <option value="{{r.key}}" {{#if r.selected}}selected{{/if}}>{{r.label}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
        {{!-- Книги, правила создания которых ещё не сверены с текстом: вести по ним
              Мастер не станет, и молчать об этом нельзя. --}}
        {{#if unaudited}}
        <p class="wizard-note">{{localize "WIZARD.UNAUDITED"}} {{unaudited}}</p>
        {{/if}}
        {{else}}
        <h2 class="wizard-step-title">{{step.label}}</h2>
        <div class="wizard-step-content" data-step="{{step.id}}" data-kind="{{step.kind}}">
            {{#if (eq step.kind "origin")}}
                {{#if originLocked}}
                {{!-- Шаг уже закреплён. Переспросить можно только через «Назад»,
                      который снимет выданное — иначе выдачи наложились бы. --}}
                <p class="wizard-locked">{{localize "WIZARD.LOCKED"}} <b>{{originName}}</b></p>
                {{else}}
                <div class="form-group">
                    <label>{{step.label}}</label>
                    <div class="form-fields">
                        <select data-origin-step="{{step.id}}">
                            <option value="">{{localize "WIZARD.CHOOSE"}}</option>
                            {{#each originOptions as |o|}}
                            <option value="{{o.uuid}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="wizard-choice-rows">{{{choiceRows}}}</div>
                {{/if}}
            {{/if}}

            {{#if (eq step.kind "characteristics")}}
                {{#if charLocked}}
                {{!-- Уже сгенерировано. «Назад» снимает запись, и шаг можно пройти заново. --}}
                <p class="wizard-locked">{{localize "WIZARD.CHAR_LOCKED"}}</p>
                {{else}}
                <div class="form-group">
                    <label>{{localize "WIZARD.METHOD"}}</label>
                    <div class="form-fields">
                        <select class="wizard-char-method">
                            {{#each charMethods as |m|}}
                            <option value="{{m.key}}" {{#if m.selected}}selected{{/if}}>{{m.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                {{#if charPointBuy}}
                <p class="wizard-note">{{localize "WIZARD.POINT_BUY_HINT"}}
                    <span class="wizard-budget" data-spent>0</span> / {{charBudget}}</p>
                {{/if}}
                <table class="wizard-chars">
                    {{#each charRows as |row|}}
                    <tr>
                        <th>{{row.label}}</th>
                        <td class="wizard-char-mod">{{#if row.modifier}}{{#if (gt row.modifier 0)}}+{{/if}}{{row.modifier}}{{/if}}</td>
                        <td>
                            <input type="number" data-characteristic="{{row.key}}" value="{{row.value}}"
                                   data-start="{{row.start}}"/>
                        </td>
                        <td>
                            {{#unless ../charPointBuy}}
                            <button type="button" class="wizard-roll" data-roll="{{row.key}}"
                                    data-formula="{{row.formula}}">{{row.formula}}</button>
                            {{/unless}}
                        </td>
                    </tr>
                    {{/each}}
                </table>
                {{#unless charPointBuy}}
                <button type="button" class="wizard-roll-all">{{localize "WIZARD.ROLL_ALL_BUTTON"}}</button>
                {{/unless}}
                {{/if}}
            {{/if}}
        </div>
        {{/unless}}
    </div>

    <footer class="wizard-footer">
        <button type="button" data-action="wizard-back" {{#if backDisabled}}disabled{{/if}}>
            {{localize "WIZARD.BACK"}}
        </button>
        <button type="button" data-action="wizard-next" {{#if nextDisabled}}disabled{{/if}}>
            {{#if isLastStep}}{{localize "WIZARD.FINISH"}}{{else}}{{localize "WIZARD.NEXT"}}{{/if}}
        </button>
    </footer>
</div>
{{/if}}
