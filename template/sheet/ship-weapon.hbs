{{!-- Корабельное орудие: те же графы, что и в нижней таблице бумажного бланка —
      тип, расположение, Сила, Крит, Урон, Дальность. --}}
<form class="{{cssClass}}" autocomplete="off">
    <div class="header border">
        <div class="flex row">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
            </div>
            <div class="flex column grow justify-center">
                <div class="name header-row">
                    <label>{{localize "WEAPON.NAME"}}</label>
                    <input name="name" type="text" value="{{item.name}}" />
                </div>
            </div>
        </div>
    </div>

    <div class="sheet-tabs tabs flex row" data-group="primary">
        <b class="item" data-tab="data">{{localize "TAB.DATA"}}</b>
        <b class="item" data-tab="notes">{{localize "TAB.NOTES"}}</b>
        <b class="item" data-tab="effects">{{localize "TAB.EFFECTS"}}</b>
    </div>

    <div class="sheet-body">
        <div class="tab" data-group="primary" data-tab="data">
            <div class="stats border">
                <h1>{{localize "TITLE.STATS"}}</h1>
                <div class="form-group">
                    <label>{{localize "SHIP.WEAPON_TYPE_LABEL"}}</label>
                    <div class="form-fields">
                        <select name="system.weaponType">
                            {{#each weaponTypes as |label key|}}
                                <option value="{{key}}" {{#if (eq ../system.weaponType key)}}selected{{/if}}>{{localize label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "SHIP.LOCATION_LABEL"}}</label>
                    <div class="form-fields">
                        <select name="system.location">
                            {{#each locations as |label key|}}
                                <option value="{{key}}" {{#if (eq ../system.location key)}}selected{{/if}}>{{localize label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "SHIP.STRENGTH"}}</label>
                    <div class="form-fields">
                        <input name="system.strength" type="number" value="{{system.strength}}" data-dtype="Number" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "SHIP.CRIT_RATING"}}</label>
                    <div class="form-fields">
                        <input name="system.critRating" type="number" value="{{system.critRating}}" data-dtype="Number" />
                    </div>
                </div>
                {{!-- Урон текстом: у корабельных орудий он записывается формулой
                      вроде «1d10+2», а не одним числом. --}}
                <div class="form-group">
                    <label>{{localize "WEAPON.DAMAGE"}}</label>
                    <div class="form-fields">
                        <input name="system.damage" type="text" value="{{system.damage}}" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.RANGE"}}</label>
                    <div class="form-fields">
                        <input name="system.range" type="number" value="{{system.range}}" data-dtype="Number" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "SHIP.POWER"}}</label>
                    <div class="form-fields">
                        <input name="system.power" type="number" value="{{system.power}}" data-dtype="Number" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "SHIP.SPACE"}}</label>
                    <div class="form-fields">
                        <input name="system.space" type="number" value="{{system.space}}" data-dtype="Number" />
                    </div>
                </div>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="effects">
            {{> systems/dark-heresy/template/sheet/item/effects.hbs}}
        </div>
        <div class="tab" data-group="primary" data-tab="notes">
            <div class="notes-editor border">
                <h1>{{localize "TITLE.NOTES"}}</h1>
                <div class="notes-editor-body">
                    {{editor enrichment.system.description target="system.description" engine="prosemirror" button=true owner=owner editable=editable}}
                </div>
            </div>
        </div>
    </div>
</form>
