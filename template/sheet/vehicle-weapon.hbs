<form class="{{cssClass}}" autocomplete="off">
    <div class="header border">
        <div class="flex row">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
            </div>
            <div class="flex column grow justify-center">
                <div class="name header-row">
                    <label>{{localize "WEAPON.NAME"}}</label>
                    <input name="name" type="text" value="{{item.name}}" />
                </div>
            </div>
        </div>
    </div>

    <div class="sheet-tabs tabs flex row" data-group="primary">
        <b class="item" data-tab="notes">{{localize "TAB.NOTES"}}</b>
        <b class="item" data-tab="data">{{localize "TAB.DATA"}}</b>
        <b class="item" data-tab="effects">{{localize "TAB.EFFECTS"}}</b>
    </div>

    <div class="sheet-body">
        <div class="tab" data-group="primary" data-tab="data">
            {{!-- Крепление и сектор идут первыми: у орудия машины они важнее
                  калибра, потому что решают, куда оно вообще может смотреть. --}}
            <div class="stats border">
                <h1>{{localize "VEHICLE.MOUNTING"}}</h1>
                <div class="form-group">
                    <label>{{localize "VEHICLE.MOUNT_LABEL"}}</label>
                    <div class="form-fields">
                        <select name="system.mount">
                            {{#each mounts as |label key|}}
                                <option value="{{key}}" {{#if (eq ../system.mount key)}}selected{{/if}}>{{localize label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "VEHICLE.FACING_LABEL"}}</label>
                    <div class="form-fields">
                        <select name="system.facing">
                            {{#each facings as |label key|}}
                                <option value="{{key}}" {{#if (eq ../system.facing key)}}selected{{/if}}>{{localize label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "VEHICLE.ARC"}}</label>
                    <div class="form-fields">
                        <input name="system.arc" type="number" value="{{system.arc}}" data-dtype="Number" />
                        <span class="units">{{localize "VEHICLE.ARC_UNIT"}}</span>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "VEHICLE.CREW_ROLE"}}</label>
                    <div class="form-fields">
                        <input name="system.crewRole" type="text" value="{{system.crewRole}}"
                               placeholder="{{localize "VEHICLE.CREW_ROLE_PLACEHOLDER"}}" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "VEHICLE.DESTROYED"}}</label>
                    <div class="form-fields">
                        <input name="system.destroyed" type="checkbox" {{checked system.destroyed}} />
                    </div>
                </div>
                {{!-- Орудию с приводом нужна работающая машина: обесточенная
                      его не поднимет и не подаст к нему ленту. --}}
                <div class="form-group">
                    <label title="{{localize "VEHICLE.POWERED_HINT"}}">{{localize "VEHICLE.POWERED"}}</label>
                    <div class="form-fields">
                        <input name="system.powered" type="checkbox" {{checked system.powered}} />
                    </div>
                </div>
            </div>

            <div class="stats border">
                <h1>{{localize "TITLE.STATS"}}</h1>
                <div class="form-group">
                    <label>{{localize "WEAPON.CLASS"}}</label>
                    <div class="form-fields">
                        <input name="system.class" type="text" value="{{system.class}}" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.RANGE"}}</label>
                    <div class="form-fields">
                        <input name="system.range" type="number" value="{{system.range}}" data-dtype="Number" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.RATE_OF_FIRE"}}</label>
                    <div class="form-fields">
                        <input name="system.rateOfFire.single" type="number" value="{{system.rateOfFire.single}}" data-dtype="Number" />
                        <input name="system.rateOfFire.burst" type="number" value="{{system.rateOfFire.burst}}" data-dtype="Number" />
                        <input name="system.rateOfFire.full" type="number" value="{{system.rateOfFire.full}}" data-dtype="Number" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.DAMAGE"}}</label>
                    <div class="form-fields">
                        <input name="system.damage" type="text" value="{{system.damage}}" />
                        <select name="system.damageType">
                            {{#each damageTypes as |label key|}}
                                <option value="{{key}}" {{#if (eq ../system.damageType key)}}selected{{/if}}>{{localize label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.PENETRATION"}}</label>
                    <div class="form-fields">
                        <input name="system.penetration" type="text" value="{{system.penetration}}" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.CLIP"}}</label>
                    <div class="form-fields">
                        <input name="system.clip.value" type="number" value="{{system.clip.value}}" data-dtype="Number" />
                        <input name="system.clip.max" type="number" value="{{system.clip.max}}" data-dtype="Number" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.RELOAD"}}</label>
                    <div class="form-fields">
                        <input name="system.reload" type="text" value="{{system.reload}}" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.SPECIAL"}}</label>
                    <div class="form-fields">
                        <input name="system.special" type="text" value="{{system.special}}" />
                    </div>
                </div>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="effects">
            {{> systems/dark-heresy/template/sheet/item/effects.hbs}}
        </div>
        <div class="tab" data-group="primary" data-tab="notes">
            <div class="notes-editor border">
                <h1>{{localize "TITLE.NOTES"}}</h1>
                <div class="notes-editor-body">
                    {{editor enrichment.system.description target="system.description" engine="prosemirror" button=true owner=owner editable=editable}}
                </div>
            </div>
        </div>
    </div>
</form>
