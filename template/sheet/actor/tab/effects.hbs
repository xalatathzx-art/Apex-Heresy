<div class="flex wrap effects">
    {{#if conditions.length}}
    <div class="conditions border">
        <h1>{{localize "EFFECTS.CONDITIONS"}}</h1>
        <div class="conditions-grid">
            {{#each conditions}}
                {{!-- A condition is its name and one control. The icon that used to lead
                      each row said nothing the name did not - eleven small pictures to
                      read six words - and it set the row's height. --}}
                <div class="condition-item {{#if this.existing}}active{{/if}}">
                    <span class="condition-name">{{this.name}}</span>
                    {{#each this.pips}}
                        <button type="button" class="pip {{#if this.filled}}filled{{/if}}"
                                data-type="{{this.type}}"
                                data-key="{{../this.id}}"
                                title="{{#if this.filled}}Remove {{../this.name}}{{else}}Add {{../this.name}}{{/if}}">
                            <i class="fas {{#if this.filled}}fa-xmark{{else}}fa-plus{{/if}}"></i>
                        </button>
                    {{/each}}
                </div>
            {{/each}}
        </div>
    </div>
    {{/if}}

    {{> systems/dark-heresy/template/sheet/item/effect-group.hbs entries=effects.active title="EFFECTS.TEMPORARY" category="temporary"}}
    {{> systems/dark-heresy/template/sheet/item/effect-group.hbs entries=effects.passive title="EFFECTS.PASSIVE" category="passive"}}
    {{> systems/dark-heresy/template/sheet/item/effect-group.hbs entries=effects.disabled title="EFFECTS.NOT_APPLYING" category="disabled"}}
    {{> systems/dark-heresy/template/sheet/item/effect-group.hbs entries=effects.itemOnly title="EFFECTS.ITEM_ONLY"}}
</div>
