<div class="flex wrap stats">
    <div class="insanities border">
        <h1>{{localize "TITLE.INSANITY"}}</h1>
        <div class="track">
            <div class="track-read">
                <input class="total" name="system.insanity" type="number" value="{{system.insanity}}" data-dtype="Number" />
                <span class="track-of">/ 100</span>
                <span class="track-bonus" data-tooltip="{{localize "CHARACTERISTIC.BONUS"}}">+{{system.insanityBonus}}</span>
                <button class="roll-insanity" type="button" data-tooltip="{{localize "TITLE.INSANITY"}}"
                        aria-label="{{localize "TITLE.INSANITY"}}"><i class="fas fa-dice"></i></button>
            </div>
            {{!-- Ten notches: the exact figure is in the field, the degree is in the row. --}}
            <div class="pips" role="img" aria-label="{{system.insanity}} / 100">
                {{#each (pipScale system.insanityPercent)}}<span class="pip{{#if this}} on{{/if}}"></span>{{/each}}
            </div>
        </div>
        <div class="item-list">
            <div class="flex header">
                <b class="name">{{localize "INSANITY.MENTAL_DISORDER"}}</b>
                <a class="button item-create" title="Add Mental Disorder" data-type="mentalDisorder"><i class="fas fa-plus"></i></a>
            </div>
            <div class="items">
                {{#each items.mentalDisorders as |item|}}
                    <div class="insanity item flex row" data-item-id="{{item.id}}">
                        <div class="flex name item-edit">
                            <div class="image-container">
                                <div class="image" style="background-image: url('{{item.img}}')"></div>
                            </div>
                            <div class="name">{{item.name}}</div>
                        </div>
                        <div class="button">
                            <a class="item-control item-delete" title="Delete Mental Disorder"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
    <div class="characteristics border">
        <h1>{{localize "TITLE.CHARACTERISTICS"}}</h1>
        <div class="left">
            {{#each system.characteristics as |characteristic key|}}
                {{#if characteristic.isLeft}}
                    {{> systems/dark-heresy/template/sheet/characteristics/left.hbs characteristic=characteristic key=key}}
                {{/if}}
            {{/each}}
        </div>
        <div class="right">
            {{#each system.characteristics as |characteristic key|}}
                {{#if characteristic.isRight}}
                    {{> systems/dark-heresy/template/sheet/characteristics/right.hbs characteristic=characteristic key=key}}
                {{/if}}
            {{/each}}
        </div>
    </div>
    <div class="corruptions border">
        <h1>{{localize "TITLE.CORRUPTION"}}</h1>
        <div class="track">
            <div class="track-read">
                <input class="total" name="system.corruption" type="number" value="{{system.corruption}}" data-dtype="Number" />
                <span class="track-of">/ 100</span>
                <span class="track-bonus" data-tooltip="{{localize "CHARACTERISTIC.BONUS"}}">+{{system.corruptionBonus}}</span>
                <button class="roll-corruption" type="button" data-tooltip="{{localize "TITLE.CORRUPTION"}}"
                        aria-label="{{localize "TITLE.CORRUPTION"}}"><i class="fas fa-dice"></i></button>
            </div>
            <div class="pips" role="img" aria-label="{{system.corruption}} / 100">
                {{#each (pipScale system.corruptionPercent)}}<span class="pip{{#if this}} on{{/if}}"></span>{{/each}}
            </div>
            {{!-- Ступень Пути Порчи. Число само по себе не говорит, насколько тяжела
                  следующая проверка на Рудименты, — а ступень и её модификатор говорят. --}}
            <div class="track-degree" data-tooltip="{{localize "CORRUPTION.DEGREE_HINT"}}">
                <span class="degree-name">{{localize system.corruptionDegree}}</span>
                {{#if system.corruptionModifier}}
                    <span class="degree-mod">{{system.corruptionModifier}}</span>
                {{/if}}
            </div>
        </div>
        <div class="item-list">
            <div class="flex header">
                <b class="name">{{localize "CORRUPTION.MALIGNANCY"}}</b>
                <a class="button item-create" title="Add Malignancy" data-type="malignancy"><i class="fas fa-plus"></i></a>
            </div>
            <div class="items">
                {{#each items.malignancies as |item|}}
                        <div class="corruption item flex row" data-item-id="{{item.id}}">
                            <div class="flex name item-edit">
                                <div class="image-container">
                                    <div class="image" style="background-image: url('{{item.img}}')"></div>
                                </div>
                                <div class="name">{{item.name}}</div>
                            </div>
                            <div class="button">
                                <a class="item-control item-delete" title="Delete Malignancy"><i class="fas fa-trash"></i></a>
                            </div>
                        </div>
                {{/each}}
            </div>
        </div>
        <div class="item-list">
            <div class="flex header">
                <b class="name">{{localize "CORRUPTION.MUTATION"}}</b>
                <a class="button item-create" title="Add Mutation" data-type="mutation"><i class="fas fa-plus"></i></a>
            </div>
            <div class="items">
                {{#each items.mutations as |item|}}
                    <div class="corruption item flex row" data-item-id="{{item.id}}">
                        <div class="flex name item-edit">
                            <div class="image-container">
                                <div class="image" style="background-image: url('{{item.img}}')"></div>
                            </div>
                            <div class="name">{{item.name}}</div>
                        </div>
                        <div class="button">
                            <a class="item-control item-delete" title="Delete Mutation"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
    <div class="skills border">
        <h1 class="section-head">
            <span>{{localize "TITLE.SKILLS"}}</span>
            <a class="button skill-create" title="{{localize "SKILL.CREATE_CUSTOM"}}" aria-label="{{localize "SKILL.CREATE_CUSTOM"}}"><i class="fas fa-plus"></i></a>
        </h1>

        {{!-- The plain skills, on one grid. --}}
        <div class="flex row skill-grid">
            {{#each system.skills as |skill key|}}
                {{#unless skill.isSpecialist}}
                    {{!-- Name, figure, proficiency in words, and the characteristic
                          the roll is made against. The proficiency used to be a
                          bare "U" in a disabled input. --}}
                    <div class="skill">
                        <div class="name">
                            <button class="roll-skill" data-skill="{{key}}" type="button">{{safeLocalize skill.label}}</button>
                        </div>
                        <input class="total" type="number" value="{{skill.total}}" data-dtype="Number" disabled />
                        <span class="dh-chip is-{{skill.advanceState}}">{{localize skill.advanceLabel}}</span>
                        <span class="skill-characteristic">{{skill.characteristics.[0]}}</span>
                    </div>
                {{/unless}}
            {{/each}}
        </div>

        {{!-- Specialist groups follow as sub-sections of the same plate, each one a
              caption over rows of the same shape. Groups the character knows nothing
              in are left out: they used to render their heading anyway, which put
              eight empty panels in a scroll box on a fresh character. --}}
        {{#each system.skills as |skill key|}}
            {{#if skill.isSpecialist}}
                {{#if skill.hasKnownSpecialities}}
                    <div class="speciality-group">
                        <p class="speciality-group-title">{{safeLocalize skill.label}}</p>
                        <div class="speciality-rows">
                            {{#each skill.specialities as |speciality keySpe|}}
                                {{#if speciality.isKnown}}
                                    <div class="skill speciality item{{#if (eq key "custom")}} is-custom{{/if}}"
                                         data-skill="{{key}}" data-speciality="{{keySpe}}">
                                        <div class="name">
                                            <button class="roll-speciality" data-speciality="{{keySpe}}" type="button">{{speciality.label}}</button>
                                        </div>
                                        <input class="total" type="number" value="{{speciality.total}}" data-dtype="Number" disabled />
                                        <span class="dh-chip is-{{speciality.advanceState}}">{{localize speciality.advanceLabel}}</span>
                                        {{!-- The speciality's own characteristic when it names one; template
                                              groups fall back to the group's. --}}
                                        <span class="skill-characteristic">{{speciality.characteristicShort}}</span>
                                        {{#if (eq key "custom")}}
                                            <a class="item-control skill-delete" title="{{localize "SKILL.DELETE_CUSTOM"}}"><i class="fas fa-trash"></i></a>
                                        {{/if}}
                                    </div>
                                {{/if}}
                            {{/each}}
                        </div>
                    </div>
                {{/if}}
            {{/if}}
        {{/each}}
    </div>
</div>
