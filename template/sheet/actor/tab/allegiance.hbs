{{!-- Кому служит еретик (Black Crusade, стр. 84).

      Покровитель стоит здесь, а не в анкете: от него зависит цена каждого улучшения,
      и менять его вслепую, между делом правя имя, не стоит. Рядом — счёт улучшений по
      богам: вожак (тот, кто оторвался на пять) и нынешний покровитель до очередной
      проверки на десяти очках Порчи — разные боги. --}}
<div class="allegiance-tab">
    <div class="allegiance border">
        <h1>{{localize "ALLEGIANCE.HEADER"}}</h1>
        <label class="bio-field">
            <span>{{localize "BIO.PATRON"}}</span>
            <select name="system.patron">
                {{selectOptions chaosPatrons selected=system.patron localize=true}}
            </select>
        </label>
        {{#if alignmentRows}}
        <div class="item-list">
            {{!-- Три числа в строке: посчитанное с листа, ручная поправка и итог.
                  Поправка нужна там, где счёт не может быть полным: у таланта или
                  психосилы из чужого компендиума покровитель может не стоять,
                  и улучшение молча уходит мимо счёта. --}}
            <div class="allegiance-head">
                <span class="name"></span>
                <span class="count" title="{{localize "ALLEGIANCE.COUNTED"}}">{{localize "ALLEGIANCE.COUNTED_SHORT"}}</span>
                <span class="manual" title="{{localize "ALLEGIANCE.MANUAL"}}">{{localize "ALLEGIANCE.MANUAL_SHORT"}}</span>
                <span class="total" title="{{localize "ALLEGIANCE.TOTAL"}}">{{localize "ALLEGIANCE.TOTAL_SHORT"}}</span>
            </div>
            {{#each alignmentRows}}
            <div class="allegiance-row{{#if isLeader}} is-leader{{/if}}{{#if isPatron}} is-patron{{/if}}">
                <span class="name">{{localize label}}</span>
                <span class="count">{{count}}</span>
                <input class="manual" type="number" name="system.alignment.{{key}}" value="{{manual}}" data-dtype="Number" />
                <span class="total">{{total}}</span>
            </div>
            {{/each}}
        </div>
        <p class="allegiance-note">{{localize "ALLEGIANCE.NOTE"}}</p>
        {{/if}}
    </div>
</div>
