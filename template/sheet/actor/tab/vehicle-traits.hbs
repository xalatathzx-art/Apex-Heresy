{{!-- Черты машины — отдельный список от человеческих: у техники свои Амфибия,
      Взрывоопасный, Развалюха, Саморемонт. Часть из них с показателем в
      скобках, поэтому он выводится рядом с названием. --}}
<div class="all-vehicle-traits border">
    <h1 class="section-head">
        <span>{{localize "VEHICLE.TAB.TRAITS"}}</span>
        <a class="button vehicle-item-create" data-type="vehicleTrait"
           title="{{localize "ITEM.ADD"}}" aria-label="{{localize "ITEM.ADD"}}"><i class="fas fa-plus"></i></a>
    </h1>

    <div class="item-list vehicle-trait-list">
        <div class="flex header">
            <b class="name">{{localize "TRAIT.NAME"}}</b>
            <b class="benefit">{{localize "TRAIT.BENEFIT"}}</b>
            <b class="controls"></b>
        </div>
        <div class="items">
            {{#each traits as |item|}}
                <div class="vehicle-trait item flex row" data-item-id="{{item.id}}">
                    <div class="name item-edit">
                        {{item.name}}{{#if item.system.hasRating}} ({{item.system.rating}}){{/if}}
                    </div>
                    <div class="benefit">{{stripHtml item.system.benefit}}</div>
                    <div class="controls">
                        <a class="item-control item-edit" title="{{localize "VEHICLE.EDIT"}}"><i class="fas fa-pen"></i></a>
                        <a class="item-control item-delete" title="{{localize "VEHICLE.REMOVE"}}"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
            {{else}}
                <p class="empty-hint">{{localize "VEHICLE.NO_TRAITS"}}</p>
            {{/each}}
        </div>
    </div>
</div>
