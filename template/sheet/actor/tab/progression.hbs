<div class="flex wrap progression">
    {{!-- Аптитьюдов в Чёрном Крестовом Походе нет вовсе: там цену задаёт бог,
          а не склонность. Панель прячется целиком, чтобы не звать заполнять
          то, что ничего не считает. --}}
    {{#if hasAptitudes}}
    <div class="aptitudes border">
        <h1>{{localize "TITLE.APTITUDES"}}</h1>
        <div class="item-list">
            <div class="flex header">
                <b class="name">{{localize "APTITUDE.NAME"}}</b>
                <a class="button item-create" title="Add Aptitude" data-type="aptitude"><i class="fas fa-plus"></i></a>
            </div>
            <div class="items">
                {{#each items.aptitudes as |item|}}                    
                    <div class="aptitude item flex row" data-item-id="{{item.id}}">
                        <div class="flex aptitude-row item-edit" title="{{removeMarkup item.description}}">
                            <div class="image-container">
                                <div class="image" style="background-image: url('{{item.img}}')"></div>
                            </div>
                            <div class="name">{{item.name}}</div>
                        </div>
                        <div class="button">
                            <a class="item-control item-delete" title="Delete Aptitude"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>                    
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}
    {{!-- На месте аптитьюдов у еретика стоит счёт принадлежности: он занимает ту
          же четверть строки, поэтому талантам и опыту двигаться не приходится.
          Отмечен вожак — тот, кто оторвался на пять улучшений, и текущий
          покровитель: до проверки на очередных десяти очках Порчи это разные боги. --}}
    {{#if alignmentRows}}
    <div class="allegiance border">
        <h1>{{localize "ALLEGIANCE.HEADER"}}</h1>
        <div class="item-list">
            {{!-- Три числа в строке: посчитанное с листа, ручная поправка и итог.
                  Поправка нужна там, где счёт не может быть полным: у таланта или
                  психосилы из чужого компендиума покровитель может не стоять,
                  и улучшение молча уходит мимо счёта. --}}
            <div class="allegiance-head">
                <span class="name"></span>
                <span class="count" title="{{localize "ALLEGIANCE.COUNTED"}}">{{localize "ALLEGIANCE.COUNTED_SHORT"}}</span>
                <span class="manual" title="{{localize "ALLEGIANCE.MANUAL"}}">{{localize "ALLEGIANCE.MANUAL_SHORT"}}</span>
                <span class="total" title="{{localize "ALLEGIANCE.TOTAL"}}">{{localize "ALLEGIANCE.TOTAL_SHORT"}}</span>
            </div>
            {{#each alignmentRows}}
            <div class="allegiance-row{{#if isLeader}} is-leader{{/if}}{{#if isPatron}} is-patron{{/if}}">
                <span class="name">{{localize label}}</span>
                <span class="count">{{count}}</span>
                <input class="manual" type="number" name="system.alignment.{{key}}" value="{{manual}}" data-dtype="Number" />
                <span class="total">{{total}}</span>
            </div>
            {{/each}}
        </div>
        <p class="allegiance-note">{{localize "ALLEGIANCE.NOTE"}}</p>
    </div>
    {{/if}}
    <div class="talents border">
        <h1>{{localize "TITLE.TALENTS"}}</h1>
        <div class="item-list">
            <div class="flex header">
                <b class="name">{{localize "TALENT.NAME"}}</b>
                <b class="cost">{{localize "TALENT.COST"}}</b>
                <b class="starter" data-tooltip="{{localize "TALENT.STARTER_HINT"}}">{{localize "TALENT.STARTER"}}</b>
                <a class="button item-create" title="Add Talent" data-type="talent"><i class="fas fa-plus"></i></a>
            </div>
            <div class="items">
                {{#each items.talents as |item|}}                    
                    <div class="talent item flex row" data-item-id="{{item.id}}">
                        <div class="flex talent-row item-edit">
                            <div class="image-container">
                                <div class="image" style="background-image: url('{{item.img}}')"></div>
                            </div>
                            <div class="name">{{item.name}}</div>
                        </div>
                        <input class="item-cost" type="number" value="{{item.cost}}" data-dtype="Number" disabled />
                        <input class="item-starter" type="checkbox" {{#if item.starter}}checked{{/if}} data-dtype="Boolean"/>
                        <div class="button">
                            <a class="item-control item-delete" title="Delete Talent"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
    <div class="experience border">
        <h1>{{localize "TITLE.EXPERIENCE"}}</h1>
        <div class="information">
            <label>{{localize "EXPERIENCE.TOTAL"}}</label>
            <input name="system.experience.value" type="number" value="{{system.experience.value}}" data-dtype="Number" />
        </div>
        <div class="information">
            <label>{{localize "EXPERIENCE.SPENT_CHARACTERISTICS"}}</label>
            <input name="system.experience.spentCharacteristics" type="number" value="{{system.experience.spentCharacteristics}}" data-dtype="Number" disabled />
        </div>
        <div class="information">
            <label>{{localize "EXPERIENCE.SPENT_SKILLS"}}</label>
            <input name="system.experience.spentSkills" type="number" value="{{system.experience.spentSkills}}" data-dtype="Number" disabled />
        </div>
        <div class="information">
            <label>{{localize "EXPERIENCE.SPENT_TALENTS"}}</label>
            <input name="system.experience.spentTalents" type="number" value="{{system.experience.spentTalents}}" data-dtype="Number" disabled />
        </div>
        <div class="information">
            <label>{{localize "EXPERIENCE.SPENT_PSYCHIC_POWERS"}}</label>
            <input name="system.experience.spentPsychicPowers" type="number" value="{{system.experience.spentPsychicPowers}}" data-dtype="Number" disabled />
        </div>
        <div class="information">
            <label>{{localize "EXPERIENCE.SPENT_OTHER"}}</label>
            <input name="system.experience.spentOther" type="number" value="{{system.experience.spentOther}}" data-dtype="Number" />
        </div>
        <div class="information">
            <label>{{localize "EXPERIENCE.TOTAL_SPENT"}}</label>
            <input name="system.experience.totalSpent" type="number" value="{{system.experience.totalSpent}}" data-dtype="Number" disabled />
        </div>
        <div class="information">
            <label>{{localize "EXPERIENCE.REMAINING"}}</label>
            <input name="system.experience.remaining" type="number" value="{{system.experience.remaining}}" data-dtype="Number" disabled />
        </div>
    </div>
    {{!-- Full width, not half. Characteristics has five columns and Skills six; at half
          the sheet their fixed columns came to 302px and squeezed the name track down
          to 21px, so the names vanished while Advance, Total and Cost kept every
          pixel. The width was pinned here inline, which no stylesheet could override. --}}
    <div class="flex column progression-column">
        <div class="characteristics border">
            <h1>{{localize "TITLE.CHARACTERISTICS"}}</h1>
            <div class="item-list">
                <div class="flex header">
                    <b class="name">{{localize "CHARACTERISTIC.NAME"}}</b>
                    <b class="advance">{{localize "CHARACTERISTIC.ADVANCE"}}</b>
                    <b class="unnatural">{{localize "CHARACTERISTIC.UNNATURAL"}}</b>
                    <b class="base">{{localize "CHARACTERISTIC.BASE"}}</b>
                    <b class="cost">{{localize "CHARACTERISTIC.COST"}}</b>
                </div>
                <div class="items">
                    {{#each system.characteristics as |characteristic key|}}
                        <div class="characteristic item flex row">
                            <div class="name">{{localize characteristic.label}}</div>
                            <select class="advance" name="system.characteristics.{{key}}.advance" data-dtype="Number">
                                {{selectOptions (config "advanceStagesCharacteristics") selected=characteristic.advance localize=true}}
                            </select>
                            <input class="unnatural" name="system.characteristics.{{key}}.unnatural" type="number" value="{{lookup (lookup ../source.characteristics key) 'unnatural'}}" data-dtype="Number" />
                            <input class="base" name="system.characteristics.{{key}}.base" type="number" value="{{lookup (lookup ../source.characteristics key) 'base'}}" data-dtype="Number" />
                            <input class="cost" name="system.characteristics.{{key}}.cost" type="number" value="{{characteristic.cost}}" data-dtype="Number" />
                        </div>
                    {{/each}}
                </div>
            </div>
        </div>
        <div class="psychic-powers border">
            <h1>{{localize "TITLE.PSYCHIC_POWERS"}}</h1>
            <div class="header">
                <div class="class">
                    <label>{{localize "PSYCHIC_POWER.CLASS"}}</label>
                    <select name="system.psy.class">
                        {{selectOptions (config "psykerClass") selected=system.psy.class localize=true}}
                    </select>
                </div>
                <div class="rating">
                    <div class="flex">
                        <label>{{localize "PSYCHIC_POWER.RATING"}}</label>
                        <input name="system.psy.rating" type="number" value="{{system.psy.rating}}" data-dtype="Number" />
                    </div>
                    <div class="flex" style="margin-top: 2px">
                        <label>{{localize "PSYCHIC_POWER.COST"}}</label>
                        <input name="system.psy.cost" type="number" value="{{system.psy.cost}}" data-dtype="Number" />
                    </div>
                </div>
            </div>
            <div class="item-list">
                <div class="flex header">
                    <b class="name">{{localize "PSYCHIC_POWER.NAME"}}</b>
                    <b class="cost">{{localize "PSYCHIC_POWER.COST"}}</b>
                    <a class="button item-create" title="Add Psychic Power" data-type="psychicPower"><i class="fas fa-plus"></i></a>
                </div>
                <div class="items">
                    {{#each items.psychicPowers as |item|}}                        
                        <div class="psychic-power item flex row" data-item-id="{{item.id}}">
                            <div class="flex psychic-powers-row item-edit">
                                <div class="image-container">
                                    <div class="image" style="background-image: url('{{item.img}}')"></div>
                                </div>
                                <div class="name">{{item.name}}</div>
                            </div>
                            <input class="item-cost" type="number" value="{{item.cost}}" data-dtype="Number" disabled />
                            <div class="button">
                                <a class="item-control item-delete" title="Delete Psychic Power"><i class="fas fa-trash"></i></a>
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
    <div class="skills border">
        <h1>{{localize "TITLE.SKILLS"}}</h1>
        <div class="item-list">
            {{!-- The add control closes the row, as in every other panel: it used to sit
                  first, which shifted every caption one column left of its values. --}}
            <div class="flex header">
                <b class="name">{{localize "SKILL.NAME"}}</b>
                <b class="advance">{{localize "SKILL.ADVANCE"}}</b>
                <b class="total">{{localize "SKILL.TOTAL"}}</b>
                <b class="cost">{{localize "SKILL.COST"}}</b>
                <b class="starter" data-tooltip="{{localize "SKILL.STARTER_HINT"}}">{{localize "SKILL.STARTER"}}</b>
                <a class="button skill-create" title="{{localize "SKILL.CREATE_CUSTOM"}}"><i class="fas fa-plus"></i></a>
            </div>
            <div class="items">
                {{#each system.skills as |skill key|}}
                    {{#unless skill.isSpecialist}}
                        <div class="skill item flex row">
                            <div class="name">{{safeLocalize skill.label}}</div>
                            <select class="advance" name="system.skills.{{key}}.advance" data-dtype="Number">
                                {{selectOptions (config "advanceStagesSkills") selected=skill.advance localize=true}}
                            </select>
                            <input class="total" name="system.skills.{{key}}.total" type="number" value="{{skill.total}}" data-dtype="Number" disabled />
                            <input class="cost" name="system.skills.{{key}}.cost" type="number" value="{{skill.cost}}" data-dtype="Number" />
                            <input class="starter" name="system.skills.{{key}}.starter" type="checkbox" {{#if skill.starter}}checked{{/if}} data-dtype="Boolean" />
                        </div>
                    {{/unless}}
                {{/each}}
                {{#each system.skills as |skill key|}}
                    {{#if skill.isSpecialist}}
                        <p class="advance-group-title">{{safeLocalize skill.label}}</p>
                        {{#each skill.specialities as |speciality keySpe|}}
                            <div class="speciality item flex row{{#if (eq key "custom")}} is-custom{{/if}}"
                                 data-skill="{{key}}" data-speciality="{{keySpe}}">
                                <div class="name">{{speciality.label}}</div>
                                <select class="advance" name="system.skills.{{key}}.specialities.{{keySpe}}.advance" data-dtype="Number">
                                    {{selectOptions (config "advanceStagesSkills") selected=speciality.advance localize=true}}
                                </select>
                                <input class="total" name="system.skills.{{key}}.specialities.{{keySpe}}.total" type="number" value="{{speciality.total}}" data-dtype="Number" disabled />
                                <input class="cost" name="system.skills.{{key}}.specialities.{{keySpe}}.cost" type="number" value="{{speciality.cost}}" data-dtype="Number" />
                                <input class="starter" name="system.skills.{{key}}.specialities.{{keySpe}}.starter" type="checkbox" {{#if speciality.starter}}checked{{/if}} data-dtype="Boolean" />
                                {{#if (eq key "custom")}}
                                    <a class="item-control skill-delete" title="{{localize "SKILL.DELETE_CUSTOM"}}"><i class="fas fa-trash"></i></a>
                                {{else}}
                                    <span></span>
                                {{/if}}
                            </div>
                        {{/each}}
                    {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
</div>