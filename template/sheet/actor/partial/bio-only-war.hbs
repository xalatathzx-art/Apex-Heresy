                        <label class="bio-field{{#if fromOrigin.[system.bio.role]}} from-origin{{/if}}"
                               title="{{#if fromOrigin.[system.bio.role]}}{{localize "BIO.FROM_ORIGIN"}}{{/if}}">
                            <span>{{localize "ORIGIN.STAGE.SPECIALITY"}}</span>
