{{!-- Полоса показателя: сначала видно состояние, потом цифры. --}}
                <div class="vital vital-fate">
                    {{!-- У Тёмной славы кнопка траты была с самого начала, а у
                          Судьбы — нет, хотя ресурс один и тот же и книга даёт
                          ей семь применений (стр. 294). --}}
                    <span class="vital-label">{{localize "FATE"}}<a class="fate-spend" title="{{localize "FATE_SPEND_TITLE"}}"><i class="fa-solid fa-bolt"></i></a></span>
                    <div class="vital-bar" role="img"
                         aria-label="{{system.fate.value}} / {{system.fate.max}}">
                        <div class="vital-fill" style="width: {{system.fate.percent}}%"></div>
                        <span class="vital-read">
                            <input name="system.fate.value" type="number" value="{{system.fate.value}}" data-dtype="Number" />
                            <span class="vital-sep">/</span>
                            <input name="system.fate.max" type="number" value="{{system.fate.max}}" data-dtype="Number" />
                        </span>
                    </div>
                </div>
