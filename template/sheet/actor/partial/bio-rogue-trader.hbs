{{!-- Анкета Rogue Trader по книжному листу (стр. 398): карьера и её ранг, родной
      мир и побуждение. Побуждение — последняя ступень Пути Происхождения, и книга
      выносит её в шапку наравне с карьерой, а не прячет среди прочих ступеней. --}}
                        <label class="bio-field{{#if fromOrigin.[system.bio.role]}} from-origin{{/if}}"
                               title="{{#if fromOrigin.[system.bio.role]}}{{localize "BIO.FROM_ORIGIN"}}{{/if}}">
                            <span>{{localize "BIO.CAREER_PATH"}}</span>
                            <input name="system.bio.role" type="text" value="{{system.bio.role}}" />
                        </label>
                        <label class="bio-field">
                            <span>{{localize "BIO.RANK"}}</span>
                            <input name="system.bio.rank" type="text" value="{{system.bio.rank}}" />
                        </label>
                        <label class="bio-field{{#if fromOrigin.[system.bio.homeWorld]}} from-origin{{/if}}"
                               title="{{#if fromOrigin.[system.bio.homeWorld]}}{{localize "BIO.FROM_ORIGIN"}}{{/if}}">
                            <span>{{localize "BIO.HOME_WORLD"}}</span>
                            <input name="system.bio.homeWorld" type="text" value="{{system.bio.homeWorld}}" />
                        </label>
                        <label class="bio-field{{#if fromOrigin.[system.bio.background]}} from-origin{{/if}}"
                               title="{{#if fromOrigin.[system.bio.background]}}{{localize "BIO.FROM_ORIGIN"}}{{/if}}">
                            <span>{{localize "BIO.MOTIVATION"}}</span>
                            <input name="system.bio.background" type="text" value="{{system.bio.background}}" />
                        </label>
                        <label class="bio-field">
                            <span>{{localize "BIO.ELITE"}}</span>
                            <input name="system.bio.elite" type="text" value="{{system.bio.elite}}" />
                        </label>
