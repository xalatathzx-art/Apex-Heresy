{{!-- Пустотный корабль Rogue Trader: тот же бумажный бланк, но нашей вёрсткой.
      Лист ничего не бросает — он ведёт учёт. Всё, что он считает сам, это
      остаток Места и Мощности да заполнение шкал. --}}
<form class="{{cssClass}}" autocomplete="off">
    <div class="voidship">
        <div class="header border">
            <div class="identity">
                <div class="avatar-wrapper">
                    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="" />
                </div>
                <div class="identity-fields">
                    <input class="actor-name" name="name" type="text" value="{{actor.name}}"
                           aria-label="{{localize "BIO.NAME"}}" />
                    <div class="bio-grid">
                        <label class="bio-field">
                            <span>{{localize "SHIP.CLASS"}}</span>
                            <input name="system.hullClass" type="text" value="{{system.hullClass}}" />
                        </label>
                        {{!-- Печатное название корпуса выше стол пишет как хочет
                              («Sword-class Frigate»), а считаем мы по этому
                              списку: от класса зависят кубик тарана и предел
                              поворота, и больше ничего. --}}
                        <label class="bio-field">
                            <span>{{localize "SHIP.HULL_TYPE_LABEL"}}</span>
                            <select name="system.hullType">
                                <option value="" {{#unless system.hullType}}selected{{/unless}}>—</option>
                                {{#each config.hullTypes as |hull key|}}
                                    <option value="{{key}}" {{#if (eq ../system.hullType key)}}selected{{/if}}>{{localize hull.label}}</option>
                                {{/each}}
                            </select>
                        </label>
                        <label class="bio-field">
                            <span>{{localize "SHIP.HULL"}}</span>
                            <input name="system.hull" type="text" value="{{system.hull}}" />
                        </label>
                        {{!-- Выучка команды — та цифра, которой бросает экипаж,
                              когда действие поручено не игроку (табл. 8-9). --}}
                        <label class="bio-field">
                            <span>{{localize "SHIP.CREW_RATING_LABEL"}}</span>
                            <select name="system.crewRating" data-dtype="Number">
                                {{#each config.crewRatings as |rating|}}
                                    <option value="{{rating.value}}" {{#if (eq ../source.crewRating rating.value)}}selected{{/if}}>{{localize rating.label}} ({{rating.value}})</option>
                                {{/each}}
                            </select>
                        </label>
                        {{!-- Ниже стоят базовые значения. Когда корабль побит
                              или команда поредела, рядом появляется то, чем он
                              на самом деле действует: держать в голове сумму
                              семи порогов стол не обязан. --}}
                        <label class="bio-field">
                            <span>{{localize "SHIP.SPEED"}}</span>
                            <input name="system.speed" type="number" value="{{source.speed}}" data-dtype="Number" />
                            {{#unless (eq system.speedEffective source.speed)}}
                                <small class="eff-now">{{localize "SHIP.NOW"}} {{system.speedEffective}}</small>
                            {{/unless}}
                        </label>
                        <label class="bio-field">
                            <span>{{localize "SHIP.MANOEUVRABILITY"}}</span>
                            <input name="system.manoeuvrability" type="number" value="{{source.manoeuvrability}}" data-dtype="Number" />
                            {{#unless (eq system.manoeuvrabilityEffective source.manoeuvrability)}}
                                <small class="eff-now">{{localize "SHIP.NOW"}} {{system.manoeuvrabilityEffective}}</small>
                            {{/unless}}
                        </label>
                        <label class="bio-field">
                            <span>{{localize "SHIP.DETECTION"}}</span>
                            <input name="system.detection" type="number" value="{{source.detection}}" data-dtype="Number" />
                            {{#unless (eq system.detectionEffective source.detection)}}
                                <small class="eff-now">{{localize "SHIP.NOW"}} {{system.detectionEffective}}</small>
                            {{/unless}}
                        </label>
                    </div>
                </div>
            </div>

            {{!-- Целостность корпуса — единственная шкала корабля: она и есть
                  его раны. Рядом стоят щиты, броня и турели: на бумаге они
                  напечатаны там же и читаются одним взглядом. --}}
            <div class="vital-strip">
                <div class="vital vital-hull">
                    <span class="vital-label">{{localize "SHIP.HULL_INTEGRITY"}}</span>
                    <div class="vital-bar" role="img"
                         aria-label="{{system.hullIntegrity.value}} / {{system.hullIntegrity.max}}">
                        <div class="vital-fill" style="width: {{system.hullIntegrity.percent}}%"></div>
                        <span class="vital-read">
                            <input name="system.hullIntegrity.value" type="number" value="{{source.hullIntegrity.value}}" data-dtype="Number" />
                            <span class="vital-sep">/</span>
                            <input name="system.hullIntegrity.max" type="number" value="{{source.hullIntegrity.max}}" data-dtype="Number" />
                        </span>
                    </div>
                </div>
                <div class="vital vital-figure">
                    <span class="vital-label">{{localize "SHIP.ARMOUR"}}</span>
                    <input name="system.armour" type="number" value="{{source.armour}}" data-dtype="Number" />
                </div>
                <div class="vital vital-figure">
                    <span class="vital-label">{{localize "SHIP.SHIELDS"}}</span>
                    <input name="system.shields" type="number" value="{{source.shields}}" data-dtype="Number" />
                </div>
                <div class="vital vital-figure">
                    <span class="vital-label">{{localize "SHIP.TURRET_RATING"}}</span>
                    <input name="system.turretRating" type="number" value="{{source.turretRating}}" data-dtype="Number" />
                </div>
            </div>

            {{!-- Что сейчас мешает кораблю. Пороги Команды и Боевого духа
                  складываются друг с другом и с обездвиженностью (стр. 224), и
                  собрать их в уме посреди боя нельзя — поэтому они собраны
                  здесь одной строкой. --}}
            {{#if system.conditionSummary.any}}
                <div class="ship-state">
                    {{#each system.conditionSummary.tags as |tag|}}
                        <span class="ship-state-tag is-{{tag.kind}}">{{localize tag.label}}</span>
                    {{/each}}
                    {{#if system.conditionSummary.mods.length}}
                        <span class="ship-state-mods">
                            {{#each system.conditionSummary.mods as |m|}}
                                <b>{{localize m.label}} {{m.text}}</b>
                            {{/each}}
                        </span>
                    {{/if}}
                </div>
            {{/if}}
        </div>

        <div class="sheet-tabs tabs flex row" data-group="primary">
            <b class="item" data-tab="profile">{{localize "SHIP.TAB.PROFILE"}}</b>
            <b class="item" data-tab="bridge">{{localize "SHIP.TAB.BRIDGE"}}</b>
            <b class="item" data-tab="components">{{localize "SHIP.TAB.COMPONENTS"}}</b>
            <b class="item" data-tab="weapons">{{localize "SHIP.TAB.WEAPONS"}}</b>
            <b class="item" data-tab="effects">{{localize "TAB.EFFECTS"}}</b>
            <b class="item" data-tab="notes">{{localize "TAB.NOTES"}}</b>
        </div>

        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="profile">
                {{> systems/dark-heresy/template/sheet/actor/tab/voidship-profile.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="bridge">
                {{> systems/dark-heresy/template/sheet/actor/tab/voidship-bridge.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="components">
                {{> systems/dark-heresy/template/sheet/actor/tab/voidship-components.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="weapons">
                {{> systems/dark-heresy/template/sheet/actor/tab/voidship-weapons.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="effects">
                {{> systems/dark-heresy/template/sheet/actor/tab/effects.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="notes">
                {{!-- Обычных заметок у корабля не было вовсе — только Осложнения и
                      заметки ведущего. Плита и поле те же, что на листе персонажа. --}}
                <div class="notes-tab notes-columns is-single">
                    <div class="divination border">
                        <h1>{{localize "TAB.NOTES"}}</h1>
                        <div class="notes-editor-body">
                            {{editor enrichment.notes target="system.notes" engine="prosemirror" button=true owner=owner editable=editable}}
                        </div>
                    </div>
                    <div class="divination border">
                        <h1>{{localize "SHIP.COMPLICATIONS"}}</h1>
                        <div class="notes-editor-body">
                            {{editor enrichment.complications target="system.complications" engine="prosemirror" button=true owner=owner editable=editable}}
                        </div>
                    </div>
                    {{#if owner}}
                        <div class="divination border">
                            <h1>{{localize "VEHICLE.GM_NOTES"}}</h1>
                            <div class="notes-editor-body">
                                {{editor enrichment.gmNotes target="system.gmNotes" engine="prosemirror" button=true owner=owner editable=editable}}
                            </div>
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</form>
