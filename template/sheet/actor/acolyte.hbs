<form class="{{cssClass}}" autocomplete="off">
    <div class="acolyte">
        <div class="header border">
            {{!-- Identity: portrait, name, four bio fields. Left-aligned throughout;
                  the name is the largest thing on the sheet because it names the sheet. --}}
            <div class="identity">
                <div class="avatar-column">
                    <div class="avatar-wrapper">
                        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="" />
                    </div>
                    {{!-- Какой книге принадлежит анкета: подпись, не заголовок. --}}
                    <span class="sheet-origin">{{localize "SHEET.ORIGIN_DARK_HERESY"}}</span>
                </div>
                <div class="identity-fields">
                    <input class="actor-name" name="name" type="text" value="{{actor.name}}"
                           aria-label="{{localize "BIO.NAME"}}" />
                    <div class="bio-grid">
                        <label class="bio-field">
                            <span>{{localize "BIO.HOME_WORLD"}}</span>
                            <input name="system.bio.homeWorld" type="text" value="{{system.bio.homeWorld}}" />
                        </label>
                        <label class="bio-field">
                            <span>{{localize "BIO.ROLE"}}</span>
                            <input name="system.bio.role" type="text" value="{{system.bio.role}}" />
                        </label>
                        <label class="bio-field">
                            <span>{{localize "BIO.BACKGROUND"}}</span>
                            <input name="system.bio.background" type="text" value="{{system.bio.background}}" />
                        </label>
                        <label class="bio-field">
                            <span>{{localize "BIO.ELITE"}}</span>
                            <input name="system.bio.elite" type="text" value="{{system.bio.elite}}" />
                        </label>
                    </div>
                </div>
            </div>

            {{!-- Vital strip: the three figures consulted most often, each as a bar so
                  the state reads before the number does. Wounds carries the hazard
                  chevron - the only place in the system that does. --}}
            <div class="vital-strip">
                <div class="vital vital-wounds{{#if system.wounds.critical}} is-critical{{/if}}">
                    <span class="vital-label">{{localize "TITLE.WOUNDS"}}</span>
                    <div class="vital-bar" role="img"
                         aria-label="{{system.wounds.value}} / {{system.wounds.max}}">
                        <div class="vital-fill" style="width: {{system.wounds.spentPercent}}%"></div>
                        <span class="vital-read">
                            <input name="system.wounds.value" type="number" value="{{system.wounds.value}}" data-dtype="Number" />
                            <span class="vital-sep">/</span>
                            <input name="system.wounds.max" type="number" value="{{system.wounds.max}}" data-dtype="Number" />
                        </span>
                    </div>
                </div>
                <div class="vital vital-fate">
                    <span class="vital-label">{{localize "FATE"}}</span>
                    <div class="vital-bar">
                        {{!-- Fate reads like the others: the fill says how much is left
                              before the figures are read. --}}
                        <div class="vital-fill" style="width: {{system.fate.percent}}%"></div>
                        <span class="vital-read">
                            <input name="system.fate.value" type="number" value="{{system.fate.value}}" data-dtype="Number" />
                            <span class="vital-sep">/</span>
                            <input name="system.fate.max" type="number" value="{{system.fate.max}}" data-dtype="Number" />
                        </span>
                    </div>
                </div>
                <div class="vital vital-fatigue">
                    <span class="vital-label">{{localize "FATIGUE"}}</span>
                    <div class="vital-bar">
                        <div class="vital-fill" style="width: {{system.fatigue.percent}}%"></div>
                        <span class="vital-read">
                            <input name="system.fatigue.value" type="number" value="{{system.fatigue.value}}" data-dtype="Number" />
                            <span class="vital-sep">/</span>
                            <input name="system.fatigue.max" type="number" value="{{system.fatigue.max}}" data-dtype="Number" />
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="sheet-tabs tabs flex row" data-group="primary">
            <b class="item" data-tab="stats">{{localize "TAB.STATS"}}</b>
            <b class="item" data-tab="combat">{{localize "TAB.COMBAT"}}</b>
            <b class="item" data-tab="abilities">{{localize "TAB.ABILITIES"}}</b>
            <b class="item" data-tab="psychic-powers">{{localize "TAB.PSYCHIC_POWERS"}}</b>
            <b class="item" data-tab="gear">{{localize "TAB.GEAR"}}</b>
            <b class="item" data-tab="progression">{{localize "TAB.ADVANCES"}}</b>
            <b class="item" data-tab="effects">{{localize "TAB.EFFECTS"}}</b>
            <b class="item" data-tab="notes">{{localize "TAB.NOTES"}}</b>
        </div>

        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="stats">
                {{> systems/dark-heresy/template/sheet/actor/tab/stats.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="combat">
                {{> systems/dark-heresy/template/sheet/actor/tab/combat.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="abilities">
                {{> systems/dark-heresy/template/sheet/actor/tab/abilities.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="psychic-powers">
                {{> systems/dark-heresy/template/sheet/actor/tab/psychic-powers.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="gear">
                {{> systems/dark-heresy/template/sheet/actor/tab/gear.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="progression">
                {{> systems/dark-heresy/template/sheet/actor/tab/progression.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="effects">
                {{> systems/dark-heresy/template/sheet/actor/tab/effects.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="notes">
                {{> systems/dark-heresy/template/sheet/actor/tab/notes.hbs}}
            </div>
        </div>
    </div>
</form>
