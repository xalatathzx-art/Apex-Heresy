<form class="{{cssClass}}" autocomplete="off">
    <div class="vehicle">
        {{!-- Шапка машины: та же плита, что у аколита, но опознаётся техника не
              родным миром и ролью, а шасси, классом и тем, кто за рычагами. --}}
        <div class="header border">
            <div class="identity">
                <div class="avatar-wrapper">
                    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="" />
                </div>
                <div class="identity-fields">
                    <input class="actor-name" name="name" type="text" value="{{actor.name}}"
                           aria-label="{{localize "BIO.NAME"}}" />
                    <div class="bio-grid">
                        <label class="bio-field">
                            <span>{{localize "VEHICLE.TYPE_LABEL"}}</span>
                            <select name="system.vehicleType">
                                {{#each config.types as |label key|}}
                                    <option value="{{key}}" {{#if (eq ../system.vehicleType key)}}selected{{/if}}>{{localize label}}</option>
                                {{/each}}
                            </select>
                        </label>
                        <label class="bio-field">
                            <span>{{localize "VEHICLE.CLASS"}}</span>
                            <input name="system.vehicleClass" type="text" value="{{system.vehicleClass}}" />
                        </label>
                        <label class="bio-field">
                            <span>{{localize "VEHICLE.ORIGIN"}}</span>
                            <input name="system.origin" type="text" value="{{system.origin}}" />
                        </label>
                        {{!-- Оператор именем — для антуража, оператор документом —
                              для бросков: Вираж катится его Управлением. --}}
                        <label class="bio-field">
                            <span>{{localize "VEHICLE.OPERATOR"}}</span>
                            <input name="system.operator" type="text" value="{{system.operator}}" />
                        </label>
                        <label class="bio-field">
                            <span>{{localize "VEHICLE.OPERATOR_ACTOR"}}</span>
                            <select name="system.operatorId">
                                <option value=""{{#unless system.operatorId}} selected{{/unless}}>—</option>
                                {{#each gunners as |crew|}}
                                    <option value="{{crew.id}}"
                                        {{#if (eq ../system.operatorId crew.id)}}selected{{/if}}>{{crew.name}}</option>
                                {{/each}}
                            </select>
                        </label>
                    </div>
                </div>
            </div>

            {{!-- Целостность — единственная полоса машины: она и есть её раны.
                  Подпись состояния читается словом, потому что от него зависят
                  штрафы и сложность ремонта. --}}
            <div class="vital-strip">
                <div class="vital vital-integrity is-{{system.integrity.state}}">
                    <span class="vital-label">{{localize "VEHICLE.INTEGRITY"}}</span>
                    <div class="vital-bar" role="img"
                         aria-label="{{system.integrity.value}} / {{system.integrity.max}}">
                        <div class="vital-fill" style="width: {{system.integrity.percent}}%"></div>
                        <span class="vital-read">
                            <input name="system.integrity.value" type="number" value="{{source.integrity.value}}" data-dtype="Number" />
                            <span class="vital-sep">/</span>
                            <input name="system.integrity.max" type="number" value="{{source.integrity.max}}" data-dtype="Number" />
                        </span>
                    </div>
                </div>
                {{!-- Критический Урон стоит отдельно от целостности: чинится он
                      поштучно и раньше неё, и именно он держит машину в
                      Критически повреждённом состоянии. --}}
                <div class="vital vital-critical">
                    <span class="vital-label">{{localize "VEHICLE.CRITICAL_DAMAGE"}}</span>
                    <input name="system.integrity.critical" type="number" value="{{source.integrity.critical}}" data-dtype="Number" />
                </div>
                <div class="vital vital-state">
                    <span class="vital-label">{{localize "VEHICLE.STATE_LABEL"}}</span>
                    <span class="dh-chip is-{{system.integrity.state}}">{{localize system.integrity.stateLabel}}</span>
                    {{#if system.integrity.operatePenalty}}
                        <span class="dh-chip is-penalty"
                              title="{{localize "VEHICLE.OPERATE_PENALTY"}}">{{system.integrity.operatePenalty}}</span>
                    {{/if}}
                </div>
            </div>
        </div>

        <div class="sheet-tabs tabs flex row" data-group="primary">
            <b class="item" data-tab="profile">{{localize "VEHICLE.TAB.PROFILE"}}</b>
            <b class="item" data-tab="weapons">{{localize "VEHICLE.TAB.WEAPONS"}}</b>
            <b class="item" data-tab="traits">{{localize "VEHICLE.TAB.TRAITS"}}</b>
            <b class="item" data-tab="effects">{{localize "TAB.EFFECTS"}}</b>
            <b class="item" data-tab="notes">{{localize "TAB.NOTES"}}</b>
        </div>

        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="profile">
                {{> systems/dark-heresy/template/sheet/actor/tab/vehicle-profile.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="weapons">
                {{> systems/dark-heresy/template/sheet/actor/tab/vehicle-weapons.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="traits">
                {{> systems/dark-heresy/template/sheet/actor/tab/vehicle-traits.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="effects">
                {{> systems/dark-heresy/template/sheet/actor/tab/effects.hbs}}
            </div>
            <div class="tab" data-group="primary" data-tab="notes">
                <div class="vehicle-notes border">
                    <h1 class="section-head"><span>{{localize "TAB.NOTES"}}</span></h1>
                    {{editor enrichment.notes target="system.notes" button=true editable=editable engine="prosemirror"}}
                </div>
                {{#if owner}}
                    <div class="vehicle-notes border">
                        <h1 class="section-head"><span>{{localize "VEHICLE.GM_NOTES"}}</span></h1>
                        {{editor enrichment.gmNotes target="system.gmNotes" button=true editable=editable engine="prosemirror"}}
                    </div>
                {{/if}}
            </div>
        </div>
    </div>
</form>
