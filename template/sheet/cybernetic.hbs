<form class="{{cssClass}}" autocomplete="off">
    <div class="header border">
        <div class="flex row">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
            </div>
            <div class="flex column grow justify-center">
                <div class="name header-row">
                    <label>{{localize "CYBERNETIC.NAME"}}</label>
                    <input name="name" type="text" value="{{item.name}}" />
                </div>
            </div>
        </div>
    </div>

    <div class="sheet-tabs tabs flex row" data-group="primary">
        <b class="item" data-tab="notes">{{localize "TAB.NOTES"}}</b>
        <b class="item" data-tab="data">{{localize "TAB.DATA"}}</b>
        <b class="item" data-tab="effects">{{localize "TAB.EFFECTS"}}</b>
        <b class="item" data-tab="scripts">{{localize "TAB.SCRIPTS"}}</b>
    </div>

    <div class="sheet-body">
        <div class="tab" data-group="primary" data-tab="data">
            <div class="stats border">
                <h1>{{localize "TITLE.STATS"}}</h1>
                <div class="form-group">
                    <label>{{localize "CYBERNETIC.INSTALLED"}}</label>
                    <div class="form-fields">
                        {{#if system.installed}}
                            <input name="system.installed" type="checkbox" value="installed" checked/>
                        {{else}}
                            <input name="system.installed" type="checkbox" value="installed"/>
                        {{/if}}
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "CYBERNETIC.CRAFTSMANSHIP"}}</label>
                    <div class="form-fields">
                        <select name="system.craftsmanship">
                            {{selectOptions (config "craftmanship") selected=system.craftsmanship localize=true}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "CYBERNETIC.AVAILABILITY"}}</label>
                    <div class="form-fields">
                        <select name="system.availability">
                            {{selectOptions (config "availability") selected=system.availability localize=true}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "CYBERNETIC.WEIGHT"}}</label>
                    <div class="form-fields">
                        <input name="system.weight" type="number" value="{{system.weight}}" data-dtype="Number" />
                    </div>
                </div>
            </div>

            {{!-- Предмет, который вдобавок защищает: синскин даёт 2 брони туда,
                  где ничего не надето. Считается наравне с доспехом. --}}
            <div class="stats border">
                <h1>{{localize "EQUIPMENT.GRANTS_ARMOUR"}}</h1>
                <div class="form-group">
                    <label>{{localize "EQUIPMENT.GRANTS_ENABLED"}}</label>
                    <div class="form-fields">
                        <input name="system.grantsArmour.enabled" type="checkbox" {{checked system.grantsArmour.enabled}} />
                    </div>
                </div>
                {{#if system.grantsArmour.enabled}}
                <div class="form-group">
                    <label>{{localize "ARMOUR.ADDITIVE"}}</label>
                    <div class="form-fields">
                        <input name="system.grantsArmour.isAdditive" type="checkbox" {{checked system.grantsArmour.isAdditive}} />
                    </div>
                </div>
                {{#each (config "hitLocations") as |label key|}}
                <div class="form-group">
                    <label>{{localize label}}</label>
                    <div class="form-fields">
                        <input name="system.grantsArmour.part.{{key}}" type="number" value="{{lookup ../system.grantsArmour.part key}}" data-dtype="Number" />
                    </div>
                </div>
                {{/each}}
                {{/if}}
            </div>

            {{!-- Предмет, который вдобавок бьёт: клинковые шпицы — оружие внутри
                  импланта. Включённый профиль выводит предмет в боевую вкладку. --}}
            <div class="stats border">
                <h1>{{localize "EQUIPMENT.GRANTS_ATTACK"}}</h1>
                <div class="form-group">
                    <label>{{localize "EQUIPMENT.GRANTS_ENABLED"}}</label>
                    <div class="form-fields">
                        <input name="system.grantsAttack.enabled" type="checkbox" {{checked system.grantsAttack.enabled}} />
                    </div>
                </div>
                {{#if system.grantsAttack.enabled}}
                <div class="form-group">
                    <label>{{localize "WEAPON.CLASS"}}</label>
                    <div class="form-fields">
                        <select name="system.grantsAttack.class">
                            {{selectOptions (config "weaponClass") selected=system.grantsAttack.class localize=true}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.DAMAGE"}}</label>
                    <div class="form-fields">
                        <input name="system.grantsAttack.damage" type="text" value="{{system.grantsAttack.damage}}" />
                        <select name="system.grantsAttack.damageType">
                            {{selectOptions (config "damageTypes") selected=system.grantsAttack.damageType localize=true}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.PENETRATION"}}</label>
                    <div class="form-fields">
                        <input name="system.grantsAttack.penetration" type="text" value="{{system.grantsAttack.penetration}}" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "WEAPON.SPECIAL"}}</label>
                    <div class="form-fields">
                        <input name="system.grantsAttack.special" type="text" value="{{system.grantsAttack.special}}" />
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="effects">
            {{> systems/dark-heresy/template/sheet/item/effects.hbs}}
        </div>
        <div class="tab" data-group="primary" data-tab="notes">
            <div class="notes-editor border">
                <h1>{{localize "TITLE.NOTES"}}</h1>
                <div class="notes-editor-body">
                    {{editor enrichment.system.description target="system.description" engine="prosemirror" button=true owner=owner editable=editable}}
                </div>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="scripts">
            <div class="scripts-editor border">
                <h1>{{localize "TITLE.SCRIPTS"}}</h1>
                <div class="scripts-editor-body">
                    <textarea name="system.scripts" class="scripts-textarea" placeholder="// Введите скрипты автоматизации здесь...">{{system.scripts}}</textarea>
                </div>
            </div>
        </div>
    </div>
</form>