{{!-- Компонент корабля. Слева смета — во что он обходится в Месте, Мощности и
      Очках корабля; справа состояние, по которому бьёт таблица критов. Пожар и
      разгерметизация стоят отдельными флажками, а не в списке состояний: по
      книге компонент может гореть, оставаясь целым. --}}
<form class="{{cssClass}}" autocomplete="off">
    <div class="header border">
        <div class="flex row">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
            </div>
            <div class="flex column grow justify-center">
                <div class="name header-row">
                    <label>{{localize "SHIP.COMPONENT.NAME"}}</label>
                    <input name="name" type="text" value="{{item.name}}" />
                </div>
            </div>
        </div>
    </div>

    <div class="sheet-tabs tabs flex row" data-group="primary">
        <b class="item" data-tab="stats">{{localize "TAB.DATA"}}</b>
        <b class="item" data-tab="notes">{{localize "TAB.NOTES"}}</b>
        <b class="item" data-tab="effects">{{localize "TAB.EFFECTS"}}</b>
    </div>

    <div class="sheet-body">
        <div class="tab" data-group="primary" data-tab="stats">
            <div class="stats border">
                <h1>{{localize "TITLE.STATS"}}</h1>

                <div class="form-group">
                    <label>{{localize "SHIP.COMPONENT.CATEGORY"}}</label>
                    <div class="form-fields">
                        <select name="system.category">
                            {{#each categories as |label key|}}
                                <option value="{{key}}" {{#if (eq ../system.category key)}}selected{{/if}}>{{localize label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "SHIP.QUALITY_LABEL"}}</label>
                    <div class="form-fields">
                        <select name="system.quality">
                            {{#each qualities as |label key|}}
                                <option value="{{key}}" {{#if (eq ../system.quality key)}}selected{{/if}}>{{localize label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "SHIP.SPACE"}}</label>
                    <div class="form-fields">
                        <input name="system.space" type="number" value="{{system.space}}" data-dtype="Number" />
                    </div>
                </div>

                {{!-- Потребление и выработка врозь: плазменный привод Мощность
                      даёт, а не тратит, и записывать его расходом со знаком
                      минус — ребус для того, кто заполняет лист. --}}
                <div class="form-group">
                    <label>{{localize "SHIP.COMPONENT.POWER_USED"}}</label>
                    <div class="form-fields">
                        <input name="system.power" type="number" value="{{system.power}}" data-dtype="Number" />
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "SHIP.COMPONENT.POWER_GENERATED"}}</label>
                    <div class="form-fields">
                        <input name="system.powerGenerated" type="number" value="{{system.powerGenerated}}" data-dtype="Number" />
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "SHIP.SHIP_POINTS"}}</label>
                    <div class="form-fields">
                        <input name="system.shipPoints" type="number" value="{{system.shipPoints}}" data-dtype="Number" />
                    </div>
                </div>
            </div>

            <div class="stats border">
                <h1>{{localize "SHIP.COMPONENT.CONDITION"}}</h1>

                <div class="form-group">
                    <label>{{localize "SHIP.COMPONENT.STATUS_LABEL"}}</label>
                    <div class="form-fields">
                        <select name="system.status">
                            {{#each statuses as |label key|}}
                                <option value="{{key}}" {{#if (eq ../system.status key)}}selected{{/if}}>{{localize label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "SHIP.COMPONENT.ON_FIRE"}}</label>
                    <div class="form-fields">
                        <input name="system.onFire" type="checkbox" {{checked system.onFire}} />
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "SHIP.COMPONENT.DEPRESSURISED"}}</label>
                    <div class="form-fields">
                        <input name="system.depressurised" type="checkbox" {{checked system.depressurised}} />
                    </div>
                </div>

                {{!-- Сколько ходов осталось до конца аварийного ремонта. Ноль —
                      ремонт не идёт. --}}
                <div class="form-group">
                    <label>{{localize "SHIP.COMPONENT.REPAIR_TURNS"}}</label>
                    <div class="form-fields">
                        <input name="system.repairTurns" type="number" value="{{system.repairTurns}}" data-dtype="Number" min="0" />
                    </div>
                </div>
            </div>
        </div>

        <div class="tab" data-group="primary" data-tab="effects">
            {{> systems/dark-heresy/template/sheet/item/effects.hbs}}
        </div>

        <div class="tab" data-group="primary" data-tab="notes">
            <div class="notes-editor border">
                <h1>{{localize "TITLE.NOTES"}}</h1>
                <div class="notes-editor-body">
                    {{editor enrichment.system.description target="system.description" engine="prosemirror" button=true owner=owner editable=editable}}
                </div>
            </div>
        </div>
    </div>
</form>
