{{!-- Кровотечение на ходу. У двух игр оно разное: в Black Crusade это бросок 10%
      на смерть, в Dark Heresy 2 — уровень усталости без всякого броска. Карточка
      показывает ту ветку, по которой считался этот актёр. --}}
<div class="dark-heresy chat roll impmal-test" data-actor-id="{{ownerId}}" {{#if tokenId}}data-token-id="{{tokenId}}"{{/if}}>
    <div class="roll-card-background dh-card {{#if isDead}}is-fail{{/if}}">

        <div class="dh-card-h">
            <span class="who">{{localize "CONDITION.BLEEDING"}} · {{localize "EFFECTS.ON_TURN"}}</span>
            <span class="verdict">
                {{#if pendingRoll}}
                    {{localize "EFFECTS.AWAITING_ROLL"}}
                {{else if lethal}}
                    {{#if isDead}}{{localize "EFFECTS.YOU_DIED"}}{{else}}{{localize "CHAT.SUCCESS"}}{{/if}}
                {{else}}
                    {{localize "CONDITION.FATIGUED"}}
                {{/if}}
            </span>
        </div>

        <div class="dh-card-b">

            {{#if pendingRoll}}
                {{!-- Бросок отдан владельцу персонажа: кости его. --}}
                <div class="effect-buttons">
                    <button type="button" class="roll-blood-loss" data-actor-id="{{actorId}}"
                            {{#if tokenId}}data-token-id="{{tokenId}}"{{/if}}>
                        {{localize "CHAT.ROLL_BLOOD_LOSS"}}
                    </button>
                </div>
            {{else if lethal}}
            <div class="dh-figures two">
                <div class="dh-fig{{#if isDead}} lead{{/if}}">
                    <span class="n">{{rollResult}}</span>
                    <span class="dh-cap">{{localize "CHAT.ROLL"}}</span>
                </div>
                <div class="dh-fig">
                    <span class="n">91+</span>
                    <span class="dh-cap">{{localize "CHAT.TARGET"}}</span>
                </div>
            </div>
            {{else}}
            <div class="dh-figures two">
                <div class="dh-fig lead">
                    <span class="n">+{{fatigueApplied}}</span>
                    <span class="dh-cap">{{localize "TITLE.FATIGUE"}}</span>
                </div>
                <div class="dh-fig">
                    <span class="n">{{newFatigue}} / {{maxFatigue}}</span>
                    <span class="dh-cap">{{localize "TITLE.FATIGUE"}}</span>
                </div>
            </div>
            {{/if}}

            <dl class="dh-kv">
                <dt class="empty"></dt>
                <dd class="full">
                    {{#if lethal}}{{localize "EFFECTS.BLEEDING_DEATH_CHANCE"}}{{else}}{{localize "EFFECTS.BLEEDING_STAUNCH"}}{{/if}}
                </dd>
            </dl>

        </div>
    </div>
</div>
