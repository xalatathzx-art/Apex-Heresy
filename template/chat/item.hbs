{{!-- Карточка предмета в чат. Все девятнадцать типов и каждое их поле сохранены
      в прежнем порядке; изменилась только подача — параметры идут списком
      «подпись → значение», а описание вынесено в конец как проза, потому что оно
      не параметр. Обёртка .background.border оставлена: на неё повешен
      обработчик двойного щелчка. --}}
<div class="dark-heresy chat item">
    <div class="background border dh-card is-neutral">

        <div class="dh-card-h">
            <span class="who">{{item.name}}</span>
            <span class="verdict">{{item.type}}</span>
        </div>

        <div class="dh-card-b">

            {{#if item.img}}
                <div class="dh-item-top no-img" style="grid-template-columns:48px;margin-bottom:var(--dh-space-3)">
                    <img src="{{item.img}}" title="{{item.name}}" alt="" />
                </div>
            {{/if}}

            <dl class="dh-kv">

                {{#if item.isAmmunition}}
                    {{#if item.weapon}}<dt>{{localize "AMMUNITION.WEAPON"}}</dt><dd>{{item.weapon}}</dd>{{/if}}
                    {{#if item.effect.damage.modifier}}<dt>{{localize "AMMUNITION.DAMAGE"}}</dt><dd>{{item.effect.damage.modifier}}{{#if item.DamageType}} {{item.DamageType}}{{/if}}</dd>{{/if}}
                    {{#if item.effect.attack.modifier}}<dt>{{localize "AMMUNITION.ATTACK"}}</dt><dd>{{item.effect.attack.modifier}}</dd>{{/if}}
                    {{#if item.effect.penetration}}<dt>{{localize "AMMUNITION.PENETRATION"}}</dt><dd>{{item.effect.penetration}}</dd>{{/if}}
                    {{#if item.effect.special}}<dt>{{localize "AMMUNITION.SPECIAL"}}</dt><dd>{{item.effect.special}}</dd>{{/if}}
                    {{#if item.weight}}<dt>{{localize "AMMUNITION.WEIGHT"}}</dt><dd>{{item.weight}}</dd>{{/if}}
                    {{#if item.Craftsmanship}}<dt>{{localize "AMMUNITION.CRAFTSMANSHIP"}}</dt><dd>{{item.Craftsmanship}}</dd>{{/if}}
                    {{#if item.Availability}}<dt>{{localize "AMMUNITION.AVAILABILITY"}}</dt><dd>{{item.Availability}}</dd>{{/if}}
                {{/if}}

                {{#if item.isArmour}}
                    {{#if item.ArmourType}}<dt>{{localize "ARMOUR.TYPE"}}</dt><dd>{{item.ArmourType}}</dd>{{/if}}
                    {{#if item.Part}}<dt>{{localize "ARMOUR.PART"}}</dt><dd>{{item.Part}}</dd>{{/if}}
                    {{#if item.maxAgility}}<dt>{{localize "ARMOUR.MAX_AGILITY"}}</dt><dd>{{item.maxAgility}}</dd>{{/if}}
                    {{#if item.weight}}<dt>{{localize "ARMOUR.WEIGHT"}}</dt><dd>{{item.weight}}</dd>{{/if}}
                    {{#if item.Craftsmanship}}<dt>{{localize "ARMOUR.CRAFTSMANSHIP"}}</dt><dd>{{item.Craftsmanship}}</dd>{{/if}}
                    {{#if item.Availability}}<dt>{{localize "ARMOUR.AVAILABILITY"}}</dt><dd>{{item.Availability}}</dd>{{/if}}
                {{/if}}

                {{#if item.isCriticalInjury}}
                    {{#if item.DamageType}}<dt>{{localize "CRITICAL_INJURY.TYPE"}}</dt><dd>{{item.DamageType}}</dd>{{/if}}
                    {{#if item.PartLocation}}<dt>{{localize "CRITICAL_INJURY.PART"}}</dt><dd>{{item.PartLocation}}</dd>{{/if}}
                {{/if}}

                {{#if item.isCybernetic}}
                    {{#if item.weight}}<dt>{{localize "CYBERNETIC.WEIGHT"}}</dt><dd>{{item.weight}}</dd>{{/if}}
                    {{#if item.Craftsmanship}}<dt>{{localize "CYBERNETIC.CRAFTSMANSHIP"}}</dt><dd>{{item.Craftsmanship}}</dd>{{/if}}
                    {{#if item.Availability}}<dt>{{localize "CYBERNETIC.AVAILABILITY"}}</dt><dd>{{item.Availability}}</dd>{{/if}}
                {{/if}}

                {{#if item.isDrug}}
                    {{#if item.weight}}<dt>{{localize "DRUG.WEIGHT"}}</dt><dd>{{item.weight}}</dd>{{/if}}
                    {{#if item.Craftsmanship}}<dt>{{localize "DRUG.CRAFTSMANSHIP"}}</dt><dd>{{item.Craftsmanship}}</dd>{{/if}}
                    {{#if item.Availability}}<dt>{{localize "DRUG.AVAILABILITY"}}</dt><dd>{{item.Availability}}</dd>{{/if}}
                {{/if}}

                {{#if item.isForceField}}
                    {{#if item.protectionRating}}<dt>{{localize "FORCE_FIELD.PROTECTION_RATING"}}</dt><dd>{{item.protectionRating}}</dd>{{/if}}
                    {{#if item.overloadChance}}<dt>{{localize "FORCE_FIELD.OVERLOAD_CHANCE"}}</dt><dd>{{item.overloadChance}}</dd>{{/if}}
                    {{#if item.weight}}<dt>{{localize "FORCE_FIELD.WEIGHT"}}</dt><dd>{{item.weight}}</dd>{{/if}}
                    {{#if item.Craftsmanship}}<dt>{{localize "FORCE_FIELD.CRAFTSMANSHIP"}}</dt><dd>{{item.Craftsmanship}}</dd>{{/if}}
                    {{#if item.Availability}}<dt>{{localize "FORCE_FIELD.AVAILABILITY"}}</dt><dd>{{item.Availability}}</dd>{{/if}}
                {{/if}}

                {{#if item.isGear}}
                    {{#if item.weight}}<dt>{{localize "GEAR.WEIGHT"}}</dt><dd>{{item.weight}}</dd>{{/if}}
                    {{#if item.Craftsmanship}}<dt>{{localize "GEAR.CRAFTSMANSHIP"}}</dt><dd>{{item.Craftsmanship}}</dd>{{/if}}
                    {{#if item.Availability}}<dt>{{localize "GEAR.AVAILABILITY"}}</dt><dd>{{item.Availability}}</dd>{{/if}}
                {{/if}}

                {{#if item.isPsychicPower}}
                    {{#if item.prerequisite}}<dt>{{localize "PSYCHIC_POWER.PREREQUISITE"}}</dt><dd>{{item.prerequisite}}</dd>{{/if}}
                    {{#if item.action}}<dt>{{localize "PSYCHIC_POWER.ACTION"}}</dt><dd>{{item.action}}</dd>{{/if}}
                    {{#if item.focusPower.test}}<dt>{{localize "PSYCHIC_POWER.FOCUS_POWER"}}</dt><dd>{{item.focusPower.test}}{{#if item.focusPower.difficulty}} ({{item.focusPower.difficulty}}){{/if}}</dd>{{/if}}
                    {{#if item.range}}<dt>{{localize "PSYCHIC_POWER.RANGE"}}</dt><dd>{{item.range}}</dd>{{/if}}
                    {{#if item.sustained}}<dt>{{localize "PSYCHIC_POWER.SUSTAINED"}}</dt><dd>{{item.sustained}}</dd>{{/if}}
                    {{#if item.psychicType}}<dt>{{localize "PSYCHIC_POWER.SUBTYPE"}}</dt><dd>{{item.psychicType}}</dd>{{/if}}
                    {{#if item.PsychicPowerZone}}<dt>{{localize "PSYCHIC_POWER.ZONE"}}</dt><dd>{{item.PsychicPowerZone}}</dd>{{/if}}
                    {{#if item.damage.formula}}<dt>{{localize "PSYCHIC_POWER.DAMAGE_FULL"}}</dt><dd>{{item.damage.formula}}{{#if item.DamageType}} {{item.DamageType}}{{/if}}</dd>{{/if}}
                    {{#if item.damage.penetration}}<dt>{{localize "PSYCHIC_POWER.PENETRATION"}}</dt><dd>{{item.damage.penetration}}</dd>{{/if}}
                    {{#if item.damage.special}}<dt>{{localize "PSYCHIC_POWER.SPECIAL"}}</dt><dd>{{item.damage.special}}</dd>{{/if}}
                    {{#if item.effect}}<dt>{{localize "PSYCHIC_POWER.EFFECT"}}</dt><dd>{{{item.effect}}}</dd>{{/if}}
                {{/if}}

                {{#if item.isSpecialAbility}}
                    {{#if item.benefit}}<dt>{{localize "SPECIAL_ABILITY.BENEFIT"}}</dt><dd>{{{item.benefit}}}</dd>{{/if}}
                {{/if}}

                {{#if item.isTalent}}
                    {{#if item.prerequisites}}<dt>{{localize "TALENT.PREREQUISITES"}}</dt><dd>{{item.prerequisites}}</dd>{{/if}}
                    {{#if item.aptitudes}}<dt>{{localize "TALENT.APTITUDES"}}</dt><dd>{{item.aptitudes}}</dd>{{/if}}
                    {{#if item.tier}}<dt>{{localize "TALENT.TIER"}}</dt><dd>{{item.tier}}</dd>{{/if}}
                {{/if}}

                {{#if item.isTool}}
                    {{#if item.weight}}<dt>{{localize "TOOL.WEIGHT"}}</dt><dd>{{item.weight}}</dd>{{/if}}
                    {{#if item.Craftsmanship}}<dt>{{localize "TOOL.CRAFTSMANSHIP"}}</dt><dd>{{item.Craftsmanship}}</dd>{{/if}}
                    {{#if item.Availability}}<dt>{{localize "TOOL.AVAILABILITY"}}</dt><dd>{{item.Availability}}</dd>{{/if}}
                {{/if}}

                {{#if item.isTrait}}
                    {{#if item.benefit}}<dt>{{localize "TRAIT.BENEFIT"}}</dt><dd>{{{item.benefit}}}</dd>{{/if}}
                {{/if}}

                {{#if item.isWeapon}}
                    {{#if item.WeaponClass}}<dt>{{localize "WEAPON.CLASS"}}</dt><dd>{{item.WeaponClass}}</dd>{{/if}}
                    {{#if item.range}}<dt>{{localize "WEAPON.RANGE"}}</dt><dd>{{item.range}}</dd>{{/if}}
                    {{#if item.RateOfFire}}<dt>{{localize "WEAPON.RATE_OF_FIRE_FULL"}}</dt><dd>{{item.RateOfFire}}</dd>{{/if}}
                    {{#if item.damage}}<dt>{{localize "WEAPON.DAMAGE_FULL"}}</dt><dd>{{item.damage}}{{#if item.DamageType}} {{item.DamageType}}{{/if}}</dd>{{/if}}
                    {{#if item.penetration}}<dt>{{localize "WEAPON.PENETRATION_FULL"}}</dt><dd>{{item.penetration}}</dd>{{/if}}
                    {{#if item.Clip}}<dt>{{localize "WEAPON.CLIP"}}</dt><dd>{{item.Clip}}</dd>{{/if}}
                    {{#if item.reload}}<dt>{{localize "WEAPON.RELOAD_FULL"}}</dt><dd>{{item.reload}}</dd>{{/if}}
                    {{#if item.special}}<dt>{{localize "WEAPON.SPECIAL"}}</dt><dd>{{item.special}}</dd>{{/if}}
                    {{#if item.weight}}<dt>{{localize "WEAPON.WEIGHT"}}</dt><dd>{{item.weight}}</dd>{{/if}}
                    {{#if item.Craftsmanship}}<dt>{{localize "WEAPON.CRAFTSMANSHIP"}}</dt><dd>{{item.Craftsmanship}}</dd>{{/if}}
                    {{#if item.Availability}}<dt>{{localize "WEAPON.AVAILABILITY"}}</dt><dd>{{item.Availability}}</dd>{{/if}}
                {{/if}}

                {{#if item.isWeaponModification}}
                    {{#if item.upgrades}}<dt>{{localize "WEAPON_MODIFICATION.UPGRADES"}}</dt><dd>{{item.upgrades}}</dd>{{/if}}
                    {{#if item.weight}}<dt>{{localize "WEAPON_MODIFICATION.WEIGHT"}}</dt><dd>{{item.weight}}</dd>{{/if}}
                    {{#if item.Craftsmanship}}<dt>{{localize "WEAPON_MODIFICATION.CRAFTSMANSHIP"}}</dt><dd>{{item.Craftsmanship}}</dd>{{/if}}
                    {{#if item.Availability}}<dt>{{localize "WEAPON_MODIFICATION.AVAILABILITY"}}</dt><dd>{{item.Availability}}</dd>{{/if}}
                {{/if}}

            </dl>

            {{!-- Описание — проза, а не параметр: набрано текстовой гарнитурой под
                  списком. Выводится для всех типов, у которых оно было, включая
                  malignancy, mentalDisorder, mutation и aptitude, у которых кроме
                  описания полей нет вовсе. --}}
            {{#if item.description}}
                <div class="dh-desc">
                    <p class="dh-desc-h">{{localize "HEADER.DESCRIPTION"}}</p>
                    {{{nl2br (stripHtmlKeepBreaks item.description)}}}
                </div>
            {{/if}}

        </div>
    </div>
</div>
